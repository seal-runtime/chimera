export const INDEX_FILE = "search-index.js"

--- The most body text one entry keeps. Results quote it, and longer text makes the index heavier to load.
const TEXT_LIMIT = 1200

const SEARCH_JS = [=====[(function () {
  // Splits names the way programmers write them: readFileSync, read_file, HTTPServer and fs.readfile all become words.
  var WORD = /\p{Lu}+(?!\p{Ll})|\p{Lu}?\p{Ll}+|\p{Lo}+|\p{N}+/gu;
  function words(text) {
    var found = text.match(WORD) || [];
    return found.map(function (word) { return word.toLowerCase(); });
  }
  function prepare(text) {
    var lower = text.toLowerCase();
    var split = words(text);
    var segments = lower.split(/[.:#/]/);
    return {
      raw: text,
      lower: lower,
      words: split,
      joined: split.join(""),
      tail: segments[segments.length - 1],
      initials: split.map(function (word) { return word.charAt(0); }).join(""),
      has_upper: /\p{Lu}/u.test(text),
    };
