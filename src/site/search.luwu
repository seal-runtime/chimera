  function prepare_text(text) {
    var lower = text.toLowerCase();
    return { raw: text, lower: lower, words: words(text) };
  }
  // Optimal string alignment distance, giving up once it passes `limit`.
  function distance(a, b, limit) {
    if (Math.abs(a.length - b.length) > limit) return limit + 1;
    var before = [];
    var previous = [];
    var current = [];
    for (var j = 0; j <= b.length; j++) previous[j] = j;
    for (var i = 1; i <= a.length; i++) {
      current = [i];
      var smallest = i;
      for (var k = 1; k <= b.length; k++) {
        var cost = a.charAt(i - 1) === b.charAt(k - 1) ? 0 : 1;
        var best = Math.min(previous[k] + 1, current[k - 1] + 1, previous[k - 1] + cost);
        if (i > 1 && k > 1 && a.charAt(i - 1) === b.charAt(k - 2) && a.charAt(i - 2) === b.charAt(k - 1)) {
          best = Math.min(best, before[k - 2] + 1);
        }
        current[k] = best;
        if (best < smallest) smallest = best;
      }
      if (smallest > limit) return limit + 1;
      before = previous;
      previous = current;
