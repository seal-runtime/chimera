const matchers: { [string]: class<Matcher>? } = {}

--[=[
    One way a [Search] matches a query against an entry. Each matcher scores a query term from 0 to 1, and the
    search multiplies that by the matcher's `weight`. The best-scoring matcher wins for each term.

    chimera's matchers run in the reader's browser: [Exact], [Prefix], [Words], [Initials], [Substring], [Typos]
    and [FullText]. Implement the trait for your own, with [Matcher:source] returning the JavaScript that scores a
    term, and register the class so parsed pages find it again.

    ## Usage

    ```luwu
    class Suffix(weight: number = 30) implements Matcher
        function source(self): string?
            return "function (term, field) { return field.lower.endsWith(term.lower) ? 1 : 0; }"
        end
    end
    Matcher.register(Suffix)

    Search():matchers({ Exact(), Prefix(), Suffix() })
    ```
]=]
export trait Matcher
    expect function __init(self, weight: number?, ...: number)
    --- What a full match of this matcher is worth, compared with the others.
    expect weight: number

    --[=[
        Numbers the matcher's JavaScript gets as its third argument, after the term and the field. [Typos] passes
        its largest allowed distance this way.

        ## Usage

        ```luwu
        function options(self): { number }
            return { self.max_distance }
        end
        ```
    ]=]
    function options(self): { number }
        return {}
    end

    --[=[
        The JavaScript function that scores a term against a field, from 0 to 1. Nil (the default) for chimera's
        own matchers, which the page script already has. The function gets the term, the field and
        [Matcher:options]. Both the term and the field have `raw`, `lower` and `words`. A name field also has
        `joined` (its words run together), `tail` (the part after its last `.` or `:`) and `initials`.

        ## Usage

        ```luwu
        function source(self): string?
            return "function (term, field) { return field.lower.endsWith(term.lower) ? 1 : 0; }"
        end
        ```
    ]=]
    function source(self): string?
        return nil
    end

    --[=[
        Whether the matcher reads an entry's body text instead of its names. Names (titles, keywords and the page's
        title) are short, so the name matchers can afford to look for typos in them.

        ## Usage

        ```luwu
        function reads_text(self): boolean
            return true
        end
        ```
    ]=]
    function reads_text(self): boolean
        return false
    end

    --[=[
        Makes parsed pages rebuild `cls` from the name [Search] stores it under, its class name.

        ## Usage

        ```luwu
        Matcher.register(Suffix)
        ```
    ]=]
    final function register(cls: class<Matcher>)
        matchers[class.name(cls)] = cls
    end

    --[=[
        The matcher a [Search] stored as `text`, like `"Typos:25:2"`: the class name, the weight, then the
        [Matcher:options]. Nil for a class that isn't registered.

        ## Usage

        ```luwu
        Matcher.decode("Typos:25:2")
        ```
    ]=]
    final function decode(text: string): Matcher?
        const name, weight, rest = string.match(text, "^([%w_]+):([%d.]+):?(.*)$")
        if not name then
            return nil
        end
        const cls = matchers[name] or return nil
        const options = { for value in string.gmatch(rest or "", "[^:]+") give tonumber(value) or 0 }
        return cls(tonumber(weight), table.unpack(options))
    end

    --[=[
        How [Search] stores the matcher in its page: the class name, the weight, then the [Matcher:options].

        ## Usage

        ```luwu
        Typos(25, 2):encode()
        ```

        ```html
        Typos:25:2
        ```
    ]=]
    final function encode(self): string
        -- LUWU FIXME: CLASS_TRAIT_BUGS 8, class.name of a trait value is typed as the trait's name
        const name: string = class.name(self)
        const parts = { name, tostring(self.weight) }
        for _, option in self:options() do
            table.insert(parts, tostring(option))
        end
        return table.concat(parts, ":")
    end
end

--[=[
    Matches a name exactly, ignoring case. It also matches the part after the last `.` or `:`, so `readfile` finds
    `fs.readfile`, and names written in another case, so `read_file` finds `readFile`.

    ## Usage

    ```luwu
    Search():matchers({ Exact(200), Prefix() })
    ```
]=]
export class Exact(weight: number = 100) implements Matcher
end

--[=[
    Matches names that start with the term, scoring higher the more of the name the term covers. `fs.read` finds
    `fs.readfile`.

    ## Usage

    ```luwu
    Prefix(80)
    ```
]=]
export class Prefix(weight: number = 80) implements Matcher
end

--[=[
    Matches a name's words in order, where words follow how programmers write names: `readFileSync`,
    `read_file_sync` and `ReadFileSync` all have the words read, file and sync. Each word of the term only has to
    start a word of the name, so `read sync` and `rea_fi` both find `readFileSync`.

    ## Usage

    ```luwu
    Words(60)
    ```
]=]
export class Words(weight: number = 60) implements Matcher
end

--[=[
    Matches the first letters of a name's words: `rfs` finds `readFileSync` and `gcd` finds `get_current_dir`.

    ## Usage

    ```luwu
    Initials(45)
    ```
]=]
export class Initials(weight: number = 45) implements Matcher
end

--[=[
    Matches the term anywhere inside a name, scoring higher the earlier it appears. `lines` finds `splitlines`.

    ## Usage

    ```luwu
    Substring(35)
    ```
]=]
export class Substring(weight: number = 35) implements Matcher
end

--[=[
    Matches names within a few typos of the term, counting a swapped pair of letters as one typo. Terms under four
    letters allow none, terms under eight allow one, and longer terms allow up to `max_distance`. `splitlnies`
    finds `splitlines`, and so does `splitlni` while it's being typed.

    ## Usage

    ```luwu
    Typos(25, 1)
    ```
]=]
export class Typos(weight: number = 25, max_distance: number = 2) implements Matcher
    function options(self): { number }
        return { self.max_distance }
    end
end

--[=[
    Matches words in an entry's body text, so a search for `utf8` finds the section that explains it even when
    its title doesn't say so. Whole words score higher than words the term only starts.

    ## Usage

    ```luwu
    FullText(15)
    ```
]=]
export class FullText(weight: number = 15) implements Matcher
    function reads_text(self): boolean
        return true
    end
end

Matcher.register(Exact)
Matcher.register(Prefix)
Matcher.register(Words)
Matcher.register(Initials)
Matcher.register(Substring)
Matcher.register(Typos)
Matcher.register(FullText)

--- The weight of each part of an entry, for [Search:weigh].
export type FieldWeights = {
    --- The entry's own name. 1 by default.
    title: number?,
    --- Other names for the entry. 0.8 by default.
    keywords: number?,
    --- The title of the page the entry is on, so `fs write` finds `writefile` on the fs page. 0.4 by default.
    page: number?,
    --- Body text, read by [FullText]. 1 by default, because FullText's own weight is low.
    text: number?,
}

const FIELD_NAMES = { "title", "keywords", "page", "text" }

const function default_matchers(): { Matcher }
    return { Exact(), Prefix(), Words(), Initials(), Substring(), Typos(), FullText() }
end

--[=[
    A `"form"` element with a search box that finds pages, sections and anything else a site's index holds, as the
    reader types. Results show up below the box, grouped by page, with the matching parts marked. Arrow keys move
    through them, Enter opens one, and `/` or Ctrl+K jumps to the box from anywhere on the page.

    Searching is built for documentation. A query finds names however they're written (`read file`, `readFile`,
    `rf` and `raedfile` all find `readFile`), and every word of a query has to match. Choose how it matches with
    [Search:matchers] and what it shows with [Search:limit], [Search:kinds] and the other methods.

    [Site:search][site.Site.search] adds one to a site's default header. [Site:build][site.Site.build] writes the
    index when any page has one.

    [site = require("@site/site")]

    ## Usage

    ```luwu
    site:search(Search()
        :placeholder("Search the docs")
        :limit(8)
        :matchers({ Exact(), Prefix(), Words(), Typos(25, 1) })
    )
    ```
]=]
export class Search implements Component
    function tag(): string
        return "form"
    end

    --- Set with [Search:placeholder].
    placeholder_text = "Search"
    --- Set with [Search:limit].
    max_results = 10
    --- Set with [Search:matchers].
    matcher_list: { Matcher } = default_matchers()
    --- Set with [Search:weigh].
    field_weights: { [string]: number? } = {}
    --- Set with [Search:kinds]. Nil shows every kind.
    shown_kinds: { string }? = nil
    --- Set with [Search:min_score].
    minimum_score = 0
    --- Set with [Search:group_by_page].
    grouped = true
    --- Set with [Search:snippets].
    show_snippets = true
    --- Set with [Search:shortcut]. Nil leaves only Ctrl+K.
    shortcut_key: string? = "/"

    function __init(self)
        self
            :add_style_class("chimera-search")
            :attr("role", "search")
    end

    --[=[
        The hint shown in the empty box. `"Search"` by default.

        ## Usage

        ```luwu
        Search():placeholder("Search the API")
        ```
    ]=]
    function placeholder(self, text: string): Search
        self.placeholder_text = text
        return self
    end

    --[=[
        The most results shown at once. 10 by default.

        ## Usage

        ```luwu
        Search():limit(5)
        ```
    ]=]
    function limit(self, count: number): Search
        self.max_results = count
        return self
    end

    --[=[
        The ways a query matches, replacing the default list: [Exact], [Prefix], [Words], [Initials], [Substring],
        [Typos] and [FullText] with their default weights. A matcher left out never matches, so leave out [Typos]
        to turn typo tolerance off.

        ## Usage

        ```luwu
        Search():matchers({ Exact(), Prefix(), Words(), Substring() })
        ```
    ]=]
    function matchers(self, list: { Matcher }): Search
        self.matcher_list = table.clone(list)
        return self
    end

    --[=[
        How much each part of an entry counts. A weight of 0 ignores that part.

        ## Usage

        ```luwu
        Search():weigh({ page = 0, keywords = 1 })
        ```
    ]=]
    function weigh(self, weights: FieldWeights): Search
        self.field_weights.title = weights.title or self.field_weights.title
        self.field_weights.keywords = weights.keywords or self.field_weights.keywords
        self.field_weights.page = weights.page or self.field_weights.page
        self.field_weights.text = weights.text or self.field_weights.text
        return self
    end

    --[=[
        Shows only entries of these kinds, like `"function"` for an API reference's search. Pages are `"page"`
        and their sections are `"section"`.

        ## Usage

        ```luwu
        Search():kinds({ "function", "type" })
        ```
    ]=]
    function kinds(self, kinds: { string }): Search
        self.shown_kinds = table.clone(kinds)
        return self
    end

    --[=[
        Leaves out results scoring below `score`. An exact match of a title scores about 100 with the default
        weights, and a match in body text about 15.

        ## Usage

        ```luwu
        Search():min_score(20)
        ```
    ]=]
    function min_score(self, score: number): Search
        self.minimum_score = score
        return self
    end

    --[=[
        Whether results show under the title of the page they're on. On by default. Off, each result names its
        page instead.

        ## Usage

        ```luwu
        Search():group_by_page(false)
        ```
    ]=]
    function group_by_page(self, on: boolean = true): Search
        self.grouped = on
        return self
    end

    --[=[
        Whether results quote the text around the match. On by default.

        ## Usage

        ```luwu
        Search():snippets(false)
        ```
    ]=]
    function snippets(self, on: boolean = true): Search
        self.show_snippets = on
        return self
    end

    --[=[
        The key that jumps to the box from anywhere on the page, `/` by default. `none` leaves only Ctrl+K.

        ## Usage

        ```luwu
        Search():shortcut("s")
        ```
    ]=]
    function shortcut(self, key: string | none): Search
        self.shortcut_key = if key == none then nil else key
        return self
    end

    --- Discards parsed children; rendering writes the box and results list again.
    function adopt(self, node: Markup): boolean
        return true
    end

    --[=[
        Sets an attribute, reading back the search's settings from the attributes it renders with, so parsed
        pages keep them.

        ## Usage

        ```luwu
        Search():attr("data-limit", "5") -- same as :limit(5)
        ```
    ]=]
    function attr(self, name: string, value: AttributeValue?): Search
        const text = if type(value) == "string" then value else nil
        if name == "data-index" or name == "data-root" then
            return self
        elseif name == "data-placeholder" then
            self.placeholder_text = text or self.placeholder_text
        elseif name == "data-limit" then
            self.max_results = tonumber(text) or self.max_results
        elseif name == "data-min-score" then
            self.minimum_score = tonumber(text) or self.minimum_score
        elseif name == "data-kinds" then
            self.shown_kinds = if text then { for kind in string.gmatch(text, "%S+") give kind } else nil
        elseif name == "data-group" then
            self.grouped = text ~= "false"
        elseif name == "data-snippets" then
            self.show_snippets = text ~= "false"
        elseif name == "data-shortcut" then
            self.shortcut_key = text
        elseif name == "data-matchers" then
            self.matcher_list = {
                for encoded in string.gmatch(text or "", "%S+")
                when const matcher = Matcher.decode(encoded)
                give matcher
            }
        elseif name == "data-fields" then
            for field, weight in string.gmatch(text or "", "([%w_]+):([%d.]+)") do
                self.field_weights[field] = tonumber(weight)
            end
        else
            Element.attr(self, name, value)
        end
        return self
    end

    function head_elements(self): { Metadata }?
        const scripts: { Metadata } = { Script(SEARCH_JS) }
        for _, matcher in self.matcher_list when const source = matcher:source() do
            -- LUWU FIXME: CLASS_TRAIT_BUGS 8, class.name of a trait value is typed as the trait's name
            const name: string = class.name(matcher)
            const reads_text = if matcher:reads_text() then "true" else "false"
            table.insert(scripts, Script(
                `(window.chimeraMatchers = window.chimeraMatchers || \{\})["{name}"] = `
                    .. `\{ text: {reads_text}, match: {source} \};`
            ))
        end
        return scripts
    end

    function render(self, out: Writer)
        const index = out:href_to(INDEX_FILE)
        const encoded_matchers = { for _, matcher in self.matcher_list give matcher:encode() }
        const encoded_fields = {
            for _, field in FIELD_NAMES
            when const weight = self.field_weights[field]
            give `{field}:{weight}`
        }
        Element.attr(self, "data-index", index)
        Element.attr(self, "data-root", string.sub(index, 1, #index - #INDEX_FILE))
        Element.attr(self, "data-matchers", table.concat(encoded_matchers, " "))
        Element.attr(self, "data-fields", if #encoded_fields > 0 then table.concat(encoded_fields, " ") else nil)
        Element.attr(self, "data-limit", tostring(self.max_results))
        Element.attr(self, "data-min-score", if self.minimum_score > 0 then tostring(self.minimum_score) else nil)
        Element.attr(self, "data-kinds", if self.shown_kinds then table.concat(self.shown_kinds, " ") else nil)
        Element.attr(self, "data-group", if self.grouped then nil else "false")
        Element.attr(self, "data-snippets", if self.show_snippets then nil else "false")
        Element.attr(self, "data-shortcut", self.shortcut_key)
        Element.attr(self, "data-placeholder", self.placeholder_text)
        self:render_open(out)
        const placeholder = Text.escape(self.placeholder_text)
        out:write(
            `<input class="chimera-search-input" type="search" placeholder="{placeholder}"`
                .. ` aria-label="{placeholder}" autocomplete="off" spellcheck="false">`
                .. `<div class="chimera-search-results" role="listbox" hidden></div></form>`
        )
    end

    function display(self, depth: number?, options: unknown?): string
        return `Search({#self.matcher_list} matchers, {self.max_results} results)`
    end

    function __tostring(self): string
        return self:display()
    end
end

Component.register(Search)

--[=[
    Whether `node` or anything inside it is a [Search], so a site knows to write its index.

    ## Usage

    ```luwu
    contains_search(document.body)
    ```
]=]
export const function contains_search(node: Markup): boolean
    if class.isinstance(node, Search) then
        return true
    end
    for _, child in node:child_nodes() do
        if contains_search(child) then
            return true
        end
    end
    return false
end

--- An entry as the index file stores it, with short keys to keep the file small.
type IndexedEntry = {
    k: string,
    t: string,
    p: string,
    g: string,
    s: string?,
    x: string?,
    w: { string }?,
}

--- Text the index reads from inside one page.
type Collecting = {
    page: string,
    path: string,
    entries: { IndexedEntry },
    current: IndexedEntry,
    text: { string },
}

const function collapse(text: string): string
    const single = string.gsub(text, "%s+", " ")
    const trimmed = string.match(single, "^%s*(.-)%s*$") or ""
    return if #trimmed > TEXT_LIMIT then string.sub(trimmed, 1, TEXT_LIMIT) else trimmed
end

const function plain_text(node: Markup, into: { string })
    if class.isinstance(node, Text) then
        table.insert(into, node.content)
        return
    elseif class.isinstance(node, Code) then
        table.insert(into, node.source)
        return
    end
    for _, child in node:child_nodes() do
        plain_text(child, into)
    end
end

const function finish_entry(state: Collecting)
    const text = collapse(table.concat(state.text, " "))
    state.current.x = if text == "" then state.current.x else text
    table.clear(state.text)
end

const function collect(node: Markup, state: Collecting, sections: boolean)
    if class.implements(node, Element) then
        if const entries = node:search_entries() then
            for _, entry in entries do
                table.insert(state.entries, {
                    k = entry.kind,
                    t = entry.title,
                    p = if entry.anchor then `{state.path}#{entry.anchor}` else state.path,
                    g = state.page,
                    s = if state.current.k == "section" then state.current.t else nil,
                    x = if entry.text then collapse(entry.text) else nil,
                    w = entry.keywords,
                })
            end
            return
        elseif node:lists_headings() or class.isinstance(node, Search) then
            return
        end
    end
    if class.isinstance(node, Heading) and sections and node.level > 1 then
        const parts: { string } = {}
        plain_text(node, parts)
        finish_entry(state)
        const id = node:get_id()
        const section: IndexedEntry = {
            k = "section",
            t = collapse(table.concat(parts)),
            p = if id then `{state.path}#{id}` else state.path,
            g = state.page,
        }
        table.insert(state.entries, section)
        state.current = section
        return
    elseif class.isinstance(node, Heading) and node.level == 1 then
        return
    elseif class.isinstance(node, Text) then
        table.insert(state.text, node.content)
        return
    elseif class.isinstance(node, Code) then
        table.insert(state.text, node.source)
        return
    end
    const inside_sections = sections and (not class.implements(node, Element) or node:contributes_headings())
    for _, child in node:child_nodes() do
        collect(child, state, inside_sections)
    end
end

--[=[
    Everything a site's [Search] can find: one entry for each page, one for each section of a page, and whatever
    elements add through [Element:search_entries][markup.Element.search_entries]. [Site:build][site.Site.build]
    builds one and writes it next to the pages when any page has a [Search].

    [markup = require("@core/markup")]
    [site = require("@site/site")]

    ## Usage

    ```luwu
    const index = SearchIndex()
        :add_page("Install", "install.html", Main { h1("Install"), h2("With seal"), Paragraph("Run ...") })
    fs.writefile("site/search-index.js", index:to_js())
    ```
]=]
export class SearchIndex
    entries: { IndexedEntry } = {}

    --[=[
        Adds a page at `path` from the site's root, with its title and the `content` to read sections and text
        from. Headings below the title become sections and link to their ids. Render the page first so its headings
        have ids. A page's `description` stands in for its text when it has one.

        ## Usage

        ```luwu
        index:add_page(page.title, page:path(), page.main, page.description)
        ```
    ]=]
    function add_page(self, title: string, path: string, content: Markup, description: string?): SearchIndex
        const page_entry: IndexedEntry = {
            k = "page",
            t = title,
            p = path,
            g = title,
            x = description,
        }
        table.insert(self.entries, page_entry)
        const state: Collecting = {
            page = title,
            path = path,
            entries = self.entries,
            current = page_entry,
            text = {},
        }
        collect(content, state, true)
        finish_entry(state)
        if description then
            page_entry.x = description
        end
        return self
    end

    --[=[
        The number of entries in the index.

        ## Usage

        ```luwu
        print(`{index:size()} entries`)
        ```
    ]=]
    function size(self): number
        return #self.entries
    end

    --[=[
        The index as the script [Search] loads, a file that also loads over `file://`.

        ## Usage

        ```luwu
        fs.writefile(fs.path.join(out_dir, INDEX_FILE), index:to_js())
        ```
    ]=]
    function to_js(self): string
        return `window.chimeraSearchIndex = {json.raw(self.entries)};\n`
    end

    function display(self, depth: number?, options: unknown?): string
        return `SearchIndex({#self.entries} entries)`
    end

    function __tostring(self): string
        return self:display()
    end
end
