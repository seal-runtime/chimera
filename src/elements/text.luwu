--!strict
--!optimize 2
--!lint ConstLocal

const markup = require("@core/markup")
const .{ Element, Component, Container, Text, HtmlElement } = require("@core/markup")
type .{ Content, Markup, Writer, MarkdownWriter } = markup

--- The text of `nodes` without markup, for comparing a heading with the id a document gives it.
const function plain_text(nodes: { read Markup }): string
    const parts: { string } = {}
    for _, node in nodes do
        if class.isinstance(node, Text) then
            table.insert(parts, node.content)
        else
            table.insert(parts, plain_text(node:child_nodes()))
        end
    end
    return table.concat(parts)
end

--- Whether `id` is the one a document would generate from `text`, so Markdown can leave it out.
const function is_generated_id(id: string, text: string): boolean
    const dashed = string.gsub(string.lower(text), "[^%w]+", "-")
    return id == (string.match(dashed, "^%-*(.-)%-*$") or "")
end

--- Markdown for inline content wrapped in `marker`, or the element's HTML when it has attributes.
const function wrapped(element: Element, children: { read Markup }, marker: string, out: MarkdownWriter): string
    if not element:only_attributes() then
        return element:to_html()
    end
    return marker .. out:inline(children) .. marker
end

const LINK_ICON = [=[<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" ]=]
    .. [=[stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 ]=]
    .. [=[0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>]=]

--- A `"p"` element that holds a paragraph of text.
export class Paragraph implements Component, Container, HtmlElement
    function tag(): string
        return "p"
    end

    function markdown(self, out: MarkdownWriter): string
        if not self:only_attributes() then
            return self:to_html()
        end
        return out:inline(self.children)
    end

    function __init(self, content: Content?)
        self:add(content)
    end
end

--[=[
    A `"h1"` to `"h6"` element that titles a section. `level` 1 is the page's title, down to 6 for the smallest
    subsection.

    [Heading.h1] to [Heading.h6] build one of each level, and destructure well.

    ```luwu
    Heading("Welcome")
    Heading({ "Install ", Code("chimera") }, 2)

    const .{ h1, h2 } = Heading
    Div { h1("Guide"), h2("Setup") }
    ```
]=]
export class Heading implements Component, Container, HtmlElement
    --- The heading's level, 1 to 6.
    level = 1

    function tag(): string
        return "h1"
    end

    function __init(self, content: Content?, level: number = 1)
        if level < 1 or level > 6 or level % 1 ~= 0 then
            error(`heading level must be a whole number from 1 to 6, got {level}`, 2)
        end
        self.level = level
        self:add(content)
    end

    function current_tag(self): string
        return `h{self.level}`
    end

    --- A heading whose only attribute is the id a document would give it anyway writes as `#` Markdown.
    function markdown(self, out: MarkdownWriter): string
        const id = self:get_id()
        const generated = id == nil or is_generated_id(id, plain_text(self.children))
        if not generated or not self:only_attributes("id") then
            return self:to_html()
        end
        return `{string.rep("#", self.level)} {out:inline(self.children)}`
    end

    --[=[
        A level 1 heading, the page's title.

        ## Usage

        ```luwu
        const .{ h1 } = Heading
        h1("Welcome"):to_html()
        ```
    ]=]
    function h1(content: Content?): Heading
        return Heading(content, 1)
    end

    --[=[
        A level 2 heading, for the page's main sections.

        ## Usage

        ```luwu
        Heading.h2("Pricing"):to_html()
        ```
    ]=]
    function h2(content: Content?): Heading
        return Heading(content, 2)
    end

    --[=[
        A level 3 heading, for subsections.

        ## Usage

        ```luwu
        Heading.h3("Monthly"):to_html()
        ```
    ]=]
    function h3(content: Content?): Heading
        return Heading(content, 3)
    end

    --[=[
        A level 4 heading.

        ## Usage

        ```luwu
        Heading.h4("Details"):to_html()
        ```
    ]=]
    function h4(content: Content?): Heading
        return Heading(content, 4)
    end

    --[=[
        A level 5 heading.

        ## Usage

        ```luwu
        Heading.h5("Notes"):to_html()
        ```
    ]=]
    function h5(content: Content?): Heading
        return Heading(content, 5)
    end

    --[=[
        A level 6 heading, the smallest.

        ## Usage

        ```luwu
        Heading.h6("Fine print"):to_html()
        ```
    ]=]
    function h6(content: Content?): Heading
        return Heading(content, 6)
    end

    --- Leaves out a parsed section link: rendering adds it back.
    function adopt(self, node: Markup): boolean
        if class.implements(node, Element) when node:has_style_class("chimera-heading-link") then
            return true
        end
        return Container.adopt(self, node)
    end

    --[=[
        Below the page title, a heading with an id gets a link to its own section when the page links headings
        (see [Document:heading_links][document.Document.heading_links]). Clicking the link also copies it.

        [document = require("@document/document")]
    ]=]
    function render(self, out: Writer)
        const id = if out.link_headings and self.level >= 2 then self:get_id() else nil
        if not id then
            return Element.render(self, out)
        end
        self:render_open(out)
        for _, child in self.children do
            child:render(out)
        end
        const href = string.gsub(id, "[\"&<>]", "")
        out:write(`<a class="chimera-heading-link" href="#{href}" aria-label="Link to this section"`)
        out:write(` onclick="chimera.copyLink(this)">{LINK_ICON}</a></{self:current_tag()}>`)
    end
end

--- A `"span"` element that marks inline text with no meaning of its own, usually to style it.
export class Span implements Component, Container, HtmlElement
    function tag(): string
        return "span"
    end

    function __init(self, content: Content?)
        self:add(content)
    end
end

--- A `"strong"` element that marks text as important, usually shown in bold.
export class Strong implements Component, Container, HtmlElement
    function tag(): string
        return "strong"
    end

    function markdown(self, out: MarkdownWriter): string
        return wrapped(self, self.children, "**", out)
    end

    function __init(self, content: Content?)
        self:add(content)
    end
end

--- An `"em"` element that stresses text, usually shown in italics.
export class Emphasis implements Component, Container, HtmlElement
    function tag(): string
        return "em"
    end

    function markdown(self, out: MarkdownWriter): string
        return wrapped(self, self.children, "*", out)
    end

    function __init(self, content: Content?)
        self:add(content)
    end
end

--- A `"small"` element that holds side comments and fine print.
export class Small implements Component, Container, HtmlElement
    function tag(): string
        return "small"
    end

    function __init(self, content: Content?)
        self:add(content)
    end
end

--- A `"pre"` element that keeps its text's whitespace as written, usually for code blocks.
export class Preformatted implements Component, Container, HtmlElement
    function tag(): string
        return "pre"
    end

    function __init(self, content: Content?)
        self:add(content)
    end
end

--- A `"blockquote"` element that quotes a passage from another source.
export class BlockQuote implements Component, Container, HtmlElement
    function tag(): string
        return "blockquote"
    end

    function markdown(self, out: MarkdownWriter): string
        if not self:only_attributes() then
            return self:to_html()
        end
        const lines = string.split(out:blocks(self.children), "\n")
        return table.concat({ for _, line in lines give if line == "" then ">" else `> {line}` }, "\n")
    end

    function __init(self, content: Content?)
        self:add(content)
    end
end

--[=[
    An `"a"` element that links to another page or location.

    ```luwu
    Link("Docs", "/docs")
    Link("Source", "https://github.com/seal-runtime/chimera"):new_tab()
    ```
]=]
export class Link implements Component, Container, HtmlElement
    function tag(): string
        return "a"
    end

    function __init(self, content: Content?, href: string?)
        self
            :add(content)
            :attr("href", href)
    end

    --[=[
        Sets where the link goes: a URL, a path, or `#id` for an element on the same page.

        ## Usage

        ```luwu
        Link("Pricing")
            :href("#pricing")
            :to_html()
        ```

        ```html
        <a href="#pricing">Pricing</a>
        ```
    ]=]
    function href(self, url: string): Link
        return self:attr("href", url)
    end

    --[=[
        Opens the link in a new tab, without giving the new page access to this one.

        ## Usage

        ```luwu
        Link("Source", "https://example.com")
            :new_tab()
            :to_html()
        ```

        ```html
        <a href="https://example.com" target="_blank" rel="noopener noreferrer">Source</a>
        ```
    ]=]
    function new_tab(self): Link
        return self
            :attr("target", "_blank")
            :attr("rel", "noopener noreferrer")
    end

    function markdown(self, out: MarkdownWriter): string
        const href = self:get_attr("href")
        if type(href) ~= "string" or not self:only_attributes("href", "title") then
            return self:to_html()
        end
        const title = self:get_attr("title")
        const quoted = if type(title) == "string" then ` "{string.gsub(title, "\"", "\\\"")}"` else ""
        const target = string.gsub(string.gsub(href, " ", "%%20"), "%)", "%%29")
        return `[{out:inline(self.children)}]({target}{quoted})`
    end
end

--- A `"br"` element that breaks a line of text.
export class LineBreak implements Component, HtmlElement
    function tag(): string
        return "br"
    end

    function __init(self) end

    function markdown(self, out: MarkdownWriter): string
        return if self:only_attributes() then "\\\n" else self:to_html()
    end
end

--- A `"hr"` element that marks a thematic break, drawn as a horizontal rule.
export class HorizontalRule implements Component, HtmlElement
    function tag(): string
        return "hr"
    end

    function __init(self) end

    function markdown(self, out: MarkdownWriter): string
        return if self:only_attributes() then "---" else self:to_html()
    end
end

for level = 1, 6 do
    Element.register_tag(`h{level}`, function()
        return Heading(nil, level)
    end)
end
