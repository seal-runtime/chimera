--!strict
--!optimize 2
--!lint ConstLocal

const markup = require("@core/markup")
const .{ Element, Component, Container, HtmlElement } = require("@core/markup")
type .{ Content, Markup, MarkdownWriter } = markup

--- A `"li"` element that holds one item of an [UnorderedList] or [OrderedList].
export class ListItem implements Container, HtmlElement
    function tag(): string
        return "li"
    end

    function __init(self, content: Content?)
        self:add(content)
    end
end

--- An item's Markdown. Its text and the lists nested under it stay on adjacent lines, keeping the list tight.
const function item_markdown(item: ListItem, out: MarkdownWriter): string
    const parts: { string } = {}
    local text: { Markup } = {}
    local tight = true
    const function flush()
        if #text > 0 then
            table.insert(parts, out:blocks(text))
            text = {}
        end
    end
    for _, child in item.children do
        if child:is_inline() then
            table.insert(text, child)
        else
            flush()
            tight = tight and class.implements(child, List)
            table.insert(parts, child:markdown(out))
        end
    end
    flush()
    return table.concat(parts, if tight then "\n" else "\n\n")
end

--[=[
    Markdown for a list's items, each starting with the marker `marker_of` gives its position. Items that hold several
    blocks make a loose list, with blank lines between items. A list or item with attributes writes as HTML.
]=]
const function list_markdown(
    list: Element,
    items: { ListItem },
    out: MarkdownWriter,
    marker_of: (number) -> string,
    ...: string
): string
    if not list:only_attributes(...) then
        return list:to_html()
    end
    for _, item in items do
        if not item:only_attributes() then
            return list:to_html()
        end
    end
    local loose = false
    const written = {
        for index, item in items
        give do
            const marker = marker_of(index)
            const indent = string.rep(" ", #marker + 1)
            const body = item_markdown(item, out)
            loose = loose or string.find(body, "\n\n", 1, true) ~= nil
            const lines = string.split(body, "\n")
            const indented = {
                for line_index, line in lines
                give if line_index == 1 then line elseif line == "" then "" else indent .. line
            }
            give string.match(`{marker} {table.concat(indented, "\n")}`, "^(.-)%s*$") or marker
    }
    return table.concat(written, if loose then "\n\n" else "\n")
end

--[=[
    The items of an [UnorderedList] or [OrderedList]. Lists hold only [ListItem]s; plain strings added to a list
    become list items.

    ## Usage

    Implement it with [Component] for your own kinds of list:

    ```luwu
    class Checklist implements chimera.Component, chimera.elements.List
        function tag(): string
            return "ul"
        end

        function __init(self, items: { string }?)
            self:add_style_class("checklist")
            for _, item in items or {} do
                self:add(item)
            end
        end
    end
    ```
]=]
export trait List needs Element
    items: { ListItem } = {}

    --[=[
        Appends items to the list. A string becomes a [ListItem] holding that text; build the [ListItem] yourself
        for richer items.

        ## Usage

        ```luwu
        UnorderedList()
            :add("Fast", ListItem({ Link("Docs", "/docs") }))
            :to_html()
        ```

        ```html
        <ul><li>Fast</li><li><a href="/docs">Docs</a></li></ul>
        ```
    ]=]
    function add(self, ...: ListItem | string): Self
        for index = 1, select("#", ...) do
            const item = select(index, ...)
            table.insert(self.items, if type(item) == "string" then ListItem(item) else item)
        end
        return self
    end

    --[=[
        Removes all items.

        ## Usage

        ```luwu
        UnorderedList({ "a", "b" })
            :clear()
            :to_html()
        ```

        ```html
        <ul></ul>
        ```
    ]=]
    function clear(self): Self
        table.clear(self.items)
        return self
    end

    function adopt(self, node: Markup): boolean
        if class.isinstance(node, ListItem) then
            table.insert(self.items, node)
            return true
        end
        return false
    end

    function child_nodes(self): { read Markup }
        return self.items
    end
end

--- A `"ul"` element that lists items with bullets.
export class UnorderedList implements Component, List, HtmlElement
    function tag(): string
        return "ul"
    end

    function markdown(self, out: MarkdownWriter): string
        return list_markdown(self, self.items, out, function()
            return "-"
        end)
    end

    function __init(self, items: { read ListItem | string }?)
        for _, item in items or {} do
            self:add(item)
        end
    end
end

--- An `"ol"` element that lists items with numbers.
export class OrderedList implements Component, List, HtmlElement
    function tag(): string
        return "ol"
    end

    function markdown(self, out: MarkdownWriter): string
        const start = tonumber(self:get_attr("start")) or 1
        return list_markdown(self, self.items, out, function(index: number)
            return `{start + index - 1}.`
        end, "start")
    end

    function __init(self, items: { read ListItem | string }?)
        for _, item in items or {} do
            self:add(item)
        end
    end

    --[=[
        Starts numbering at `first` instead of 1.

        ## Usage

        ```luwu
        OrderedList({ "Install", "Run" })
            :start(3)
            :to_html()
        ```

        ```html
        <ol start="3"><li>Install</li><li>Run</li></ol>
        ```
    ]=]
    function start(self, first: number): OrderedList
        return self:attr("start", first)
    end
end
