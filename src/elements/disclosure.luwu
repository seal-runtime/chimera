--!strict
--!optimize 2
--!lint ConstLocal

const markup = require("@core/markup")
const .{ Component, Container, Child, HtmlElement } = require("@core/markup")
type .{ Content, Markup } = markup

--- A `"summary"` element that heads a [Details], visible while its content is hidden.
export class Summary implements Container, HtmlElement
    function tag(): string
        return "summary"
    end

    function __init(self, content: Content?)
        self:add(content)
    end
end

--[=[
    A `"details"` element the reader can expand and hide, with a [Summary] that stays visible while its content is
    hidden. [Details] and the `Panel` component implement it.

    ## Usage

    ```luwu
    class Spoiler implements Component, Disclosure
        function tag(): string
            return "details"
        end
    end
    ```
]=]
export trait Disclosure needs Container
    summary: Summary? = nil

    --[=[
        Shows the content when the page loads; `open(false)` starts it collapsed again.

        ## Usage

        ```luwu
        Details("Question?", Paragraph("Answer."))
            :open()
            :to_html()
        ```

        ```html
        <details open><summary>Question?</summary><p>Answer.</p></details>
        ```
    ]=]
    function open(self, is_open: boolean?): Self
        return self:attr("open", is_open ~= false)
    end

    --- Sets what the [Summary] says, replacing any it had.
    function title(self, title: Summary | Content): Self
        self.summary = if class.isinstance(title, Summary) then title else Summary(title)
        return self
    end

    function adopt(self, node: Markup): boolean
        if class.isinstance(node, Summary) then
            self.summary = node
            return true
        end
        if class.implements(node, Child) then
            table.insert(self.children, node)
            return true
        end
        return false
    end

    function clear(self): Self
        self.summary = nil
        table.clear(self.children)
        return self
    end

    function child_nodes(self): { read Markup }
        const summary = self.summary or return self.children
        const nodes: { Markup } = { summary }
        for _, child in self.children do
            table.insert(nodes, child)
        end
        return nodes
    end
end

--[=[
    A `"details"` element that lets the reader expand and hide its content, with no JavaScript.

    ```luwu
    Details("What does it cost?", Paragraph("Nothing.")):open()
    ```
]=]
export class Details implements Component, HtmlElement, Disclosure
    function tag(): string
        return "details"
    end

    function __init(self, summary: Summary | Content?, content: Content?)
        if summary ~= nil then
            self:title(summary)
        end
        self:add(content)
    end
end
