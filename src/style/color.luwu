--- xterm's default 16 colors, indexed from 0.
const ANSI_BASIC: { string } = {
    "#000000",
    "#cd0000",
    "#00cd00",
    "#cdcd00",
    "#0000ee",
    "#cd00cd",
    "#00cdcd",
    "#e5e5e5",
    "#7f7f7f",
    "#ff0000",
    "#00ff00",
    "#ffff00",
    "#5c5cff",
    "#ff00ff",
    "#00ffff",
    "#ffffff",
}

const ANSI_CUBE_LEVELS: { number } = { 0, 95, 135, 175, 215, 255 }

--[=[
    Checks a literal hex color at the call: a `#` followed by 3, 4, 6 or 8 hex digits. A mistake is a type error
    saying what's wrong.

    ## Usage

    ```luwu
    Color.hex("#3b5bdb") -- ok
    Color.hex("3b5bdb")  -- hex color '3b5bdb' is missing its '#'; write '#3b5bdb'
    Color.hex("#3b5bd")  -- hex color '#3b5bd' has 5 digits; use 3 (#rgb), 4 (#rgba), 6 (#rrggbb) or 8 (#rrggbbaa)
    Color.hex("#3g5bdb") -- hex color '#3g5bdb' has characters that aren't hex digits: 'g'
    ```
]=]
type function HexColor(hex: type): type
    if not hex:is("singleton") then
        return types.error("expected a literal hex color like \"#3b5bdb\"; use Color.parse_hex for other strings")
    end
    const text = hex:value()
    if typeof(text) ~= "string" then
        return types.error("expected a hex color string, got " .. tostring(text))
    end
    if string.sub(text, 1, 1) ~= "#" then
        return types.error("hex color '" .. text .. "' is missing its '#'; write '#" .. text .. "'")
    end
    const digits = string.sub(text, 2)
    const invalid = string.gsub(digits, "%x", "")
    if invalid ~= "" then
        return types.error("hex color '" .. text .. "' has characters that aren't hex digits: '" .. invalid .. "'")
    end
    if #digits ~= 3 and #digits ~= 4 and #digits ~= 6 and #digits ~= 8 then
        return types.error(
            "hex color '" .. text .. "' has " .. tostring(#digits) .. " digits;"
                .. " use 3 (#rgb), 4 (#rgba), 6 (#rrggbb) or 8 (#rrggbbaa)"
        )
    end
    return hex
end

const function parse_hex_digits(text: string): Color?
    if string.sub(text, 1, 1) ~= "#" then
        return nil
    end
    local digits = string.sub(text, 2)
    if not string.match(digits, "^%x+$") then
        return nil
    elseif #digits == 3 or #digits == 4 then
        digits = string.gsub(digits, "%x", "%0%0")
    elseif #digits ~= 6 and #digits ~= 8 then
        return nil
    end
    const red = tonumber(string.sub(digits, 1, 2), 16) or 0
    const green = tonumber(string.sub(digits, 3, 4), 16) or 0
    const blue = tonumber(string.sub(digits, 5, 6), 16) or 0
    const alpha = if #digits == 8 then (tonumber(string.sub(digits, 7, 8), 16) or 255) / 255 else 1
    return Color(red, green, blue, alpha)
end

const function channel(value: number): number
    return math.clamp(math.round(value), 0, 255)
end

const function hex_byte(value: number): string
    return string.format("%02x", channel(value))
end

--[=[
    An sRGB color: red, green and blue channels from 0 to 255, and an alpha from 0 (clear) to 1 (opaque).
    Styles take colors directly; they render as CSS.

    ## Usage

    ```luwu
    const accent = Color(232, 89, 12)
    const ink = Color.hex("#1d1d1f")
    const glass = Color.named("white"):with_alpha(0.6)

    Div("Note"):style({ color = ink, border_left = `4px solid {accent}`, background = glass })
    print(accent:mix(ink, 0.5)) -- shows a swatch in the terminal
    ```
]=]
export class Color(const r: number, const g: number, const b: number, const a = 1)
    --[=[
        One of the CSS named colors; the name is type checked and autocompletes.

        ## Usage

        ```luwu
        Color.named("rebeccapurple"):to_css()
        Color.named("transparent"):to_css()
        ```

        ```css
        #663399
        rgb(0 0 0 / 0)
        ```
    ]=]
    function named(name: NamedColor): Color
        return parse_hex_digits(NAMED_HEX[name] or "#000000") or Color(0, 0, 0)
    end

    --[=[
        A color from a hex literal: `#rgb`, `#rgba`, `#rrggbb` or `#rrggbbaa`. The literal is checked when the code
        is typechecked. A missing `#`, a wrong digit count or a non-hex character is a type error at the call.
        For hex text only known at runtime, use [Color.parse_hex].

        ## Usage

        ```luwu
        Color.hex("#3b5bdb")
        Color.hex("#fff8")
        Color.hex("3b5bdb") -- type error: hex color '3b5bdb' is missing its '#'; write '#3b5bdb'
        ```
    ]=]
    function hex(hex: HexColor<literal<string>>): Color
        return parse_hex_digits(hex) or error("invalid hex color '" .. hex .. "'", 2)
    end

    --[=[
        A color from hex text known only at runtime, like a config value. Accepts the same forms as
        [Color.hex] and returns nil for anything else.

        ## Usage

        ```luwu
        Color.parse_hex(settings.accent) or Color.named("orange")
        ```
    ]=]
    function parse_hex(text: string): Color?
        return parse_hex_digits(text)
    end

    --[=[
        A color from a vector's x, y and z as red, green and blue, each from 0 to 255, with optional alpha.

        ## Usage

        ```luwu
        Color.from_vector(vector.create(255, 128, 0), 0.5)
        ```
    ]=]
    function from_vector(rgb: vector, a: number?): Color
        return Color(rgb.x, rgb.y, rgb.z, a or 1)
    end

    --[=[
        A color unpacked from a `0xRRGGBBAA` number, the format [Color:to_u32] writes.

        ## Usage

        ```luwu
        Color.from_u32(0x3b5bdbff)
        ```
    ]=]
    function from_u32(packed: number): Color
        return Color(
            bit32.extract(packed, 24, 8),
            bit32.extract(packed, 16, 8),
            bit32.extract(packed, 8, 8),
            bit32.extract(packed, 0, 8) / 255
        )
    end

    --[=[
        A color read from four bytes of `data` (red, green, blue, alpha), starting at `offset` (0 by default). The
        format [Color:write_buffer] writes.

        ## Usage

        ```luwu
        const pixels = fs.readfile("image.rgba")
        const second_pixel = Color.from_buffer(buffer.fromstring(pixels), 4)
        ```
    ]=]
    function from_buffer(data: buffer, offset: number?): Color
        const at = offset or 0
        return Color(
            buffer.readu8(data, at),
            buffer.readu8(data, at + 1),
            buffer.readu8(data, at + 2),
            buffer.readu8(data, at + 3) / 255
        )
    end

    --[=[
        Reads a terminal color code: 24-bit (`38;2;r;g;b`), 256-color (`38;5;n`) or one of the basic 16
        (`31`, `92`, ...). Background codes work too. Returns nil for anything else.

        ```luwu
        Color.from_ansi("\27[38;2;255;128;0m")
        Color.from_ansi("\27[34m")
        ```
    ]=]
    function from_ansi(code: string): Color?
        const params = string.match(code, "^\27%[([%d;]+)m$") or string.match(code, "^([%d;]+)$") or return nil
        const numbers = { for part in string.gmatch(params, "%d+") give tonumber(part) or 0 }
        const first = numbers[1] or return nil
        if (first == 38 or first == 48) and numbers[2] == 2 and #numbers == 5 then
            return Color(numbers[3], numbers[4], numbers[5])
        elseif (first == 38 or first == 48) and numbers[2] == 5 and #numbers == 3 then
            return Color.from_ansi_index(numbers[3])
        elseif #numbers == 1 then
            if (first >= 30 and first <= 37) or (first >= 40 and first <= 47) then
                return Color.from_ansi_index(first % 10)
            elseif (first >= 90 and first <= 97) or (first >= 100 and first <= 107) then
                return Color.from_ansi_index(first % 10 + 8)
            end
        end
        return nil
    end

    --[=[
        One of the 256 xterm colors by index: 0-15 are the basic colors, 16-231 a 6x6x6 color cube, 232-255 grays.
        Nil for anything outside 0-255.

        ## Usage

        ```luwu
        Color.from_ansi_index(196)
        ```
    ]=]
    function from_ansi_index(index: number): Color?
        if index < 0 or index > 255 or index % 1 ~= 0 then
            return nil
        elseif index < 16 then
            return parse_hex_digits(ANSI_BASIC[index + 1])
        elseif index < 232 then
            const cube = index - 16
            return Color(
                ANSI_CUBE_LEVELS[cube // 36 + 1],
                ANSI_CUBE_LEVELS[cube // 6 % 6 + 1],
                ANSI_CUBE_LEVELS[cube % 6 + 1]
            )
        end
        const gray = 8 + (index - 232) * 10
        return Color(gray, gray, gray)
    end

    --[=[
        The color as hex: `#rrggbb`, or `#rrggbbaa` when it isn't opaque.

        ## Usage

        ```luwu
        Color(255, 128, 0):to_hex()
        Color(255, 128, 0, 0.5):to_hex()
        ```

        ```css
        #ff8000
        #ff800080
        ```
    ]=]
    function to_hex(self): string
        const rgb = "#" .. hex_byte(self.r) .. hex_byte(self.g) .. hex_byte(self.b)
        return if self.a >= 1 then rgb else rgb .. hex_byte(self.a * 255)
    end

    --[=[
        The color as a CSS value: hex when opaque, `rgb(r g b / a)` otherwise. This is what styles, palettes and
        string interpolation write.

        ## Usage

        ```luwu
        Color(255, 128, 0):to_css()
        Color(255, 128, 0, 0.5):to_css()
        ```

        ```css
        #ff8000
        rgb(255 128 0 / 0.5)
        ```
    ]=]
    function to_css(self): string
        if self.a >= 1 then
            return self:to_hex()
        end
        const alpha = math.round(math.clamp(self.a, 0, 1) * 1000) / 1000
        return "rgb("
            .. tostring(channel(self.r)) .. " "
            .. tostring(channel(self.g)) .. " "
            .. tostring(channel(self.b)) .. " / "
            .. tostring(alpha) .. ")"
    end

    --[=[
        The red, green and blue channels as a vector's x, y and z (alpha is dropped).

        ## Usage

        ```luwu
        Color(255, 128, 0):to_vector()
        ```
    ]=]
    function to_vector(self): vector
        return vector.create(self.r, self.g, self.b)
    end

    --[=[
        The color packed into one number as `0xRRGGBBAA`, with channels rounded to whole bytes.

        ## Usage

        ```luwu
        string.format("%08x", Color(59, 91, 219):to_u32())
        ```
    ]=]
    function to_u32(self): number
        const alpha = channel(self.a * 255)
        return bit32.bor(
            bit32.lshift(channel(self.r), 24),
            bit32.lshift(channel(self.g), 16),
            bit32.lshift(channel(self.b), 8),
            alpha
        )
    end

    --[=[
        A new four-byte buffer holding red, green, blue and alpha, each 0 to 255.

        ## Usage

        ```luwu
        Color(65, 66, 67):to_buffer()
        ```
    ]=]
    function to_buffer(self): buffer
        const data = buffer.create(4)
        self:write_buffer(data, 0)
        return data
    end

    --[=[
        Writes the four bytes of [Color:to_buffer] into `data` at `offset` (0 by default), for filling pixel data.

        ## Usage

        ```luwu
        const pixels = buffer.create(4 * 2)
        Color.named("red"):write_buffer(pixels, 0)
        Color.named("blue"):write_buffer(pixels, 4)
        ```
    ]=]
    function write_buffer(self, data: buffer, offset: number?)
        const at = offset or 0
        buffer.writeu8(data, at, channel(self.r))
        buffer.writeu8(data, at + 1, channel(self.g))
        buffer.writeu8(data, at + 2, channel(self.b))
        buffer.writeu8(data, at + 3, channel(self.a * 255))
    end

    --[=[
        The 24-bit terminal escape code that switches to this color. Reset with `"\27[0m"`.

        ```luwu
        print(Color.named("tomato"):to_ansi() .. "warning" .. "\27[0m")
        ```
    ]=]
    function to_ansi(self, layer: AnsiLayer?): string
        const select_code = if layer == "background" then 48 else 38
        return "\27[" .. tostring(select_code) .. ";2;"
            .. tostring(channel(self.r)) .. ";"
            .. tostring(channel(self.g)) .. ";"
            .. tostring(channel(self.b)) .. "m"
    end

    --[=[
        The same color with alpha `a`, from 0 (clear) to 1 (opaque).

        ## Usage

        ```luwu
        Color.named("black"):with_alpha(0.25)
        ```
    ]=]
    function with_alpha(self, a: number): Color
        return Color(self.r, self.g, self.b, a)
    end

    --[=[
        A blend between this color and `other`, alpha included: 0 gives this color, 1 gives `other`.

        ## Usage

        ```luwu
        Color.named("white"):mix(Color.named("black"), 0.5)
        ```
    ]=]
    function mix(self, other: Color, amount: number): Color
        return Color(
            self.r + (other.r - self.r) * amount,
            self.g + (other.g - self.g) * amount,
            self.b + (other.b - self.b) * amount,
            self.a + (other.a - self.a) * amount
        )
    end

    function __eq(self, other: Color): boolean
        return self:to_u32() == other:to_u32()
    end

    function __tostring(self): string
        return self:to_css()
    end

    function display(self, depth: number?, options: unknown?): string
        return self:to_ansi("background") .. "    \27[0m Color(" .. self:to_css() .. ")"
    end
end
