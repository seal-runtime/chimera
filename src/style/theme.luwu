            Rule(".chimera-chip-info", {
                ["--chimera-chip-color"] = token("syntax_info"),
                ["--chimera-chip-text"] = token("on_info"),
            }),
            Rule(".chimera-chip-warning", {
                ["--chimera-chip-color"] = token("syntax_warning"),
                ["--chimera-chip-text"] = token("on_warning"),
            }),
            Rule(".chimera-chip-error", {
                ["--chimera-chip-color"] = token("syntax_error"),
                ["--chimera-chip-text"] = token("on_error"),
            }),
            -- A pixel-art icon's fixed size spills evenly into the padding so the chip's height doesn't change.
            Rule(".chimera-chip-icon", {
                display = "inline-flex",
                margin_block = "calc((1.1em - var(--chimera-chip-icon-size, 1.1em)) / 2)",
            }),
            Rule(".chimera-chip-icon > svg, .chimera-chip-icon > img", {
                display = "block",
                width = "var(--chimera-chip-icon-size, 1.1em)",
                height = "var(--chimera-chip-icon-size, 1.1em)",
            }),
            Rule(".chimera-chip-pixel-icon > img", { image_rendering = "pixelated" }),
        }
    end

    --- Every theme class is findable by its name with [Theme.find]. Parsing a page looks up the theme names on its
    --- `<html>` tag there.
    final function __implemented(cls: class<Theme>)
        const name = cls().name
        if themes_by_name[name] then
            error(`two theme classes are named '{name}'; rename one so pages can tell them apart`, 2)
        end
        themes_by_name[name] = cls
    end

    --[=[
        The theme class called `name`, or nil when no theme class has that name.

        ## Usage

        ```luwu
        const dark = Theme.find("dark")
        ```
    ]=]
    final function find(name: string): class<Theme>?
        return themes_by_name[name]
    end
end
