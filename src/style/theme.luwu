            Rule(".chimera-card > :last-child", { margin_bottom = "0" }),
        }
    end

    --[=[
        Makes the theme class `cls` findable by its name with [Theme.find]. Parsing a page looks up the theme names
        on its `<html>` tag here. Register every theme your pages use.

        ## Usage

        ```luwu
        Theme.register(Sepia)
        Parser():parse_document(html).light_theme
        ```
    ]=]
    final function register(cls: class<Theme>)
        themes_by_name[cls().name] = cls
    end

    --[=[
        The registered theme called `name`, or nil. Every theme in [themes] is registered.

        [themes = require("@themes")]

        ## Usage

        ```luwu
        const dark = Theme.find("dark")
        ```
    ]=]
    final function find(name: string): class<Theme>?
        return themes_by_name[name]
    end
end
