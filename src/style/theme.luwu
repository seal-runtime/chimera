--!strict
--!optimize 2
--!lint ConstLocal

const .{ Style, Rule } = require("@style/style")
const .{ Color } = require("@color")
const .{ Token, token } = require("@style/token")

--[=[
    The design tokens a [Theme] sets: its [Color]s, plus the corner radius, spacing, padding, fonts and shadow every
    element uses. Fields left out use the [Light][themes.Light] defaults.

    ## Usage

    Return one from a theme's [Theme:palette], setting only the tokens that change:

    ```luwu
    const .{ Theme, Palette, Color } = chimera.style

    class Sepia() implements Theme
        const name = "sepia"
        const mode = "Light"

        function palette(self): Palette
            return Palette {
                background = Color.hex("#f4ecd8"),
                text = Color(91, 70, 54),
                primary = Color.named("saddlebrown"),
                radius = "2px",
            }
        end
    end
    ```

    [themes = require("@themes")]
]=]
export class Palette
    background = Color.hex("#ffffff")
    surface = Color.hex("#f5f5f7")

    text = Color.hex("#1d1d1f")
    muted = Color.hex("#6e6e73")
    primary = Color.hex("#3b5bdb")
    primary_text = Color.hex("#ffffff")
    accent = Color.hex("#e8590c")
    border = Color.hex("#d2d2d7")
    radius = "8px"
    spacing = "1rem"
    --- The space inside boxes like cards, code blocks and collapsible sections.
    padding = "1.25rem"
    --- The space between the page's content and the edges of the screen.
    gutter = "1.5rem"
    --- The narrowest a column in a row or grid gets before the layout wraps it onto a line of its own.
    column_width = "12rem"
    font = "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    mono_font = "ui-monospace, 'JetBrains Mono', Menlo, monospace"
    shadow = "0 1px 3px rgba(0, 0, 0, 0.12)"
    --- Code highlighting colors, used by code blocks.
    syntax_keyword = Color.hex("#cf222e")
    syntax_string = Color.hex("#0a3069")
    syntax_number = Color.hex("#0550ae")
    syntax_comment = Color.hex("#6e7781")
    syntax_function = Color.hex("#8250df")
    syntax_type = Color.hex("#953800")
    syntax_builtin = Color.hex("#0550ae")
    syntax_constant = Color.hex("#0550ae")
    --- Bracket pairs in code, by nesting depth: three clearly different hues, unlike the other syntax colors.
    syntax_bracket_1 = Color.hex("#a07c00")
    syntax_bracket_2 = Color.hex("#0e8a7d")
    syntax_bracket_3 = Color.hex("#c13a8e")
    --- Squiggle colors under code: errors, lint warnings and information.
    syntax_error = Color.hex("#d1242f")
    syntax_warning = Color.hex("#bf8700")
    syntax_info = Color.hex("#0969da")

    --[=[
        The palette as CSS custom properties, one `--chimera-<token>` per token. A [Document][document.Document] writes
        them under `:root[data-theme="<name>"]` for each theme it offers. [token] reads them.

        ## Usage

        ```luwu
        Palette({ primary = Color(59, 91, 219) }):variables()
        ```

        ```css
        :root[data-theme="light"]{--chimera-accent: #e8590c; ... --chimera-primary: #3b5bdb; ...}
        ```

        [document = require("@document/document")]
    ]=]
    function variables(self): Style
        return Style {
            ["--chimera-background"] = self.background,
            ["--chimera-surface"] = self.surface,

            ["--chimera-text"] = self.text,
            ["--chimera-muted"] = self.muted,
            ["--chimera-primary"] = self.primary,
            ["--chimera-primary-text"] = self.primary_text,
            ["--chimera-accent"] = self.accent,
            ["--chimera-border"] = self.border,
            ["--chimera-radius"] = self.radius,
            ["--chimera-spacing"] = self.spacing,
            ["--chimera-padding"] = self.padding,
            ["--chimera-gutter"] = self.gutter,
            ["--chimera-column-width"] = self.column_width,
            ["--chimera-font"] = self.font,
            ["--chimera-mono-font"] = self.mono_font,
            ["--chimera-shadow"] = self.shadow,
            ["--chimera-syntax-keyword"] = self.syntax_keyword,
            ["--chimera-syntax-string"] = self.syntax_string,
            ["--chimera-syntax-number"] = self.syntax_number,
            ["--chimera-syntax-comment"] = self.syntax_comment,
            ["--chimera-syntax-function"] = self.syntax_function,
            ["--chimera-syntax-type"] = self.syntax_type,
            ["--chimera-syntax-builtin"] = self.syntax_builtin,
            ["--chimera-syntax-constant"] = self.syntax_constant,
            ["--chimera-syntax-bracket-1"] = self.syntax_bracket_1,
            ["--chimera-syntax-bracket-2"] = self.syntax_bracket_2,
            ["--chimera-syntax-bracket-3"] = self.syntax_bracket_3,
            ["--chimera-syntax-error"] = self.syntax_error,
            ["--chimera-syntax-warning"] = self.syntax_warning,
            ["--chimera-syntax-info"] = self.syntax_info,
            ["--chimera-on-muted"] = self:text_on(self.muted),
            ["--chimera-on-info"] = self:text_on(self.syntax_info),
            ["--chimera-on-warning"] = self:text_on(self.syntax_warning),
            ["--chimera-on-error"] = self:text_on(self.syntax_error),
        }
    end

    --[=[
        The palette's text or background color, whichever reads better on `fill`. When neither reaches the 4.5
        contrast body text needs, it's black or white instead. Chips filled with a theme color use it for their label.

        ## Usage

        ```luwu
        Palette({}):text_on(Color.hex("#bf8700"))
        ```
    ]=]
    function text_on(self, fill: Color): Color
        const themed = fill:readable(self.text, self.background)
        fill:contrast(themed) < 4.5 or return themed
        return fill:readable(Color(0, 0, 0), Color(255, 255, 255))
    end

    function display(self, depth: number?, options: unknown?): string
        return `Palette(primary = {self.primary}, background = {self.background})`
    end
end

--[=[
    Whether a [Theme] is light or dark. Pages pick their first theme of the reader's OS mode until the reader picks
    one with a [ThemeSwitcher][components.ThemeSwitcher].

    [components = require("@components/components")]
]=]
export type ThemeMode = "Light" | "Dark"

const themes_by_name: { [string]: class<Theme> } = {}

--[=[
    A named look for a document: a [Palette] of tokens plus the base [Rule]s of every element.

    A [Document][document.Document] can offer several themes and switch between them at build time or in the
    browser. Base styles read only tokens. Switching themes swaps token values and restyles every element.

    ## Usage

    A theme needs a unique `name`, a [ThemeMode], and a constructor without arguments. Override [Theme:palette] to
    set its tokens, and `base_styles` to restyle elements: start from [Theme.base_styles] for the defaults, then
    add rules.
    Register the theme so parsed documents can find it by name.

    ```luwu
    const .{ Theme, Palette, Rule, Color } = chimera.style

    class Dracula() implements Theme
        const name = "dracula"
        const mode = "Dark"

        function palette(self): Palette
            return Palette {
                background = Color.hex("#282a36"),
                surface = Color.hex("#343746"),
                text = Color.hex("#f8f8f2"),
                primary = Color.hex("#bd93f9"),
            }
        end

        function base_styles(self): { Rule }
            const rules = Theme.base_styles(self)
            table.insert(rules, Rule("button", { text_transform = "uppercase" }))
            return rules
        end
    end

    page:default_dark_theme(Dracula)
    ```

    [document = require("@document/document")]
]=]
export trait Theme
    expect function __init(self)
    expect const name: string
    expect const mode: ThemeMode

    --- The theme's design tokens. Defaults to the light [Palette]; override it to set your own.
    function palette(self): Palette
        return Palette()
    end

    --[=[
        The name readers see in a theme picker. Defaults to the theme's `name` in title case.

        ## Usage

        ```luwu
        Mocha():label()
        ```
    ]=]
    function label(self): string
        const words = {
            for word in string.gmatch(self.name, "[^%-_ ]+")
            give string.upper(string.sub(word, 1, 1)) .. string.sub(word, 2)
        }
        return table.concat(words, " ")
    end

    --[=[
        The base CSS for every element and built-in component, written with theme tokens.

        Override it in your theme to restyle elements: call [Theme.base_styles] for the defaults, then add rules.

        ## Usage

        ```luwu
        function base_styles(self): { Rule }
            const rules = Theme.base_styles(self)
            table.insert(rules, Rule("button", { text_transform = "uppercase" }))
            return rules
        end
        ```
    ]=]
    function base_styles(self): { Rule }
        const border = `1px solid {token("border")}`
        const row_blocks = ".chimera-column, .chimera-grid, .chimera-card, .chimera-code-block"
        -- Full-width bars line their content up with the 64rem page column.
        const page_gutter = Token(`max({token("gutter")}, calc((100% - 64rem) / 2 + {token("gutter")}))`)
        const folded_items = ":not(.chimera-brand):not(.chimera-theme-switcher):not(.chimera-menu-toggle)"
            .. ":not(.chimera-search)"
        return {
            Rule("*, *::before, *::after", { box_sizing = "border-box" }),
            Rule("body", {
                margin = "0",
                background = token("background"),
                color = token("text"),
                font_family = token("font"),
                font_size = "1.0625rem",
                line_height = "1.65",
                overflow_wrap = "break-word",
                webkit_font_smoothing = "antialiased",
                transition = "background 0.25s, color 0.25s",
            }),
            Rule("main", {
                max_width = "64rem",
                margin = "0 auto",
                padding_top = "2rem",
                padding_bottom = "4rem",
                padding_inline = token("gutter"),
            }),
            Rule("main > :first-child", { margin_top = "0" }),
            Rule("h1, h2, h3, h4, h5, h6", {
                line_height = "1.15",
                letter_spacing = "-0.02em",
                margin = "2em 0 0.6em",
            }),
            Rule("h1", { font_size = "clamp(2.2rem, 5vw, 3rem)" }),
            Rule("h2", { font_size = "1.75rem" }),
            Rule(":is(h2, h3, h4, h5, h6)[id]", { ["scroll-margin-top"] = "5rem" }),
            Rule(".chimera-heading-link", {
                display = "inline-flex",
                margin_left = "0.4em",
                color = token("muted"),
                vertical_align = "middle",
                opacity = 0,
                transition = "opacity 0.15s, color 0.15s",
            }),
            Rule(":is(h2, h3, h4, h5, h6):hover > .chimera-heading-link, .chimera-heading-link:focus-visible", {
                opacity = 1,
            }),
            Rule(".chimera-heading-link:hover, .chimera-heading-link[data-copied]", { color = token("primary") }),
            Rule("@media (hover: none)", {}, {
                Rule(".chimera-heading-link", { opacity = 0.55 }),
            }),
            Rule("p", { margin = "0 0 1em" }),
            Rule("a", {
                color = token("primary"),
                text_decoration = "none",
                transition = "color 0.15s",
            }),
            Rule("a:hover", {
                color = token("accent"),
                text_decoration = "underline",
                text_underline_offset = "0.2em",
            }),
            -- Code passed a link takes the link's color instead of syntax colors.
            Rule("a > .chimera-code", { color = "inherit" }),
            Rule("img", {
                max_width = "100%",
                height = "auto",
            }),
            Rule("code, pre", { font_family = token("mono_font") }),
            Rule("code", {
                font_size = "0.9em",
                padding = "0.15em 0.4em",
                background = token("surface"),
                border = border,
                border_radius = "6px",
            }),
            Rule("pre", {
                padding = token("padding"),
                overflow_x = "auto",
                -- The size code blocks use, so program output reads at the size of the code above it.
                font_size = "0.875rem",
                line_height = "1.55",
                background = token("surface"),
                border = border,
                border_radius = token("radius"),
            }),
            Rule("pre code", {
                padding = "0",
                background = "none",
                border = "none",
                font_size = "0.875rem",
            }),
            Rule("blockquote", {
                margin = "1.5em 0",
                padding = "0.25em 0 0.25em 1.25em",
                border_left = `3px solid {token("primary")}`,
                color = token("muted"),
            }),
            Rule("hr", {
                border = "none",
                border_top = border,
                margin = "2.5em 0",
            }),
            Rule("button", {
                font = "inherit",
                font_weight = "600",
                cursor = "pointer",
                padding = "0.6em 1.15em",
                border = "none",
                border_radius = token("radius"),
                background = token("primary"),
                color = token("primary_text"),
                transition = "filter 0.15s, transform 0.15s",
            }),
            Rule("button:hover", {
                filter = "brightness(1.08)",
                transform = "translateY(-1px)",
            }),
            Rule("button:disabled", {
                opacity = "0.5",
                cursor = "not-allowed",
                transform = "none",
            }),
            Rule("input, select, textarea", {
                font = "inherit",
                padding = "0.5em 0.7em",
                border = border,
                border_radius = token("radius"),
                background = token("background"),
                color = token("text"),
            }),
            Rule("input:focus, select:focus, textarea:focus", {
                outline = `2px solid {token("primary")}`,
                outline_offset = "1px",
            }),
            Rule("table", {
                border_collapse = "collapse",
                width = "100%",
                margin = "1.5em 0",
                font_size = "0.95rem",
            }),
            -- A table too wide for a phone scrolls inside itself instead of squeezing its columns.
            Rule("@media (max-width: 700px)", {}, {
                Rule("table", {
                    display = "block",
                    overflow_x = "auto",
                }),
            }),
            Rule("th, td", {
                text_align = "left",
                padding = "0.65em 0.8em",
                border_bottom = border,
            }),
            Rule("th", {
                color = token("muted"),
                font_size = "0.8rem",
                letter_spacing = "0.06em",
                text_transform = "uppercase",
            }),
            Rule(".chimera-table-striped tbody tr:nth-child(even)", { background = token("surface") }),
            Rule(".chimera-table-plain-header th", { font_weight = "normal" }),
            Rule(".chimera-table-grid th, .chimera-table-grid td", { border = border }),
            Rule(".chimera-table-none th, .chimera-table-none td", { border = "none" }),
            Rule(".chimera-table-compact th, .chimera-table-compact td", { padding = "0.25em 0.5em" }),
            Rule(".chimera-table-hover tbody tr:hover", { background = token("surface") }),
            Rule("details", {
                margin = "0.75em 0",
                padding_block = token("padding"):times(0.75),
                padding_inline = token("padding"),
                background = token("surface"),
                border = border,
                border_radius = token("radius"),
            }),
            Rule("summary", {
                cursor = "pointer",
                font_weight = "600",
            }),
            Rule("details[open] > summary", { margin_bottom = "0.6em" }),
            Rule("details > :last-child", { margin_bottom = "0" }),
            Rule(".chimera-menu", {
                position = "sticky",
                top = "0",
                z_index = "30",
                display = "flex",
                align_items = "center",
                gap = "1.5rem",
                padding_block = "0.85rem",
                padding_inline = page_gutter,
                background = `color-mix(in srgb, {token("background")} 82%, transparent)`,
                webkit_backdrop_filter = "blur(12px)",
                backdrop_filter = "blur(12px)",
                border_bottom = border,
            }),
            Rule(".chimera-menu a", {
                color = token("muted"),
                font_weight = "500",
                white_space = "nowrap",
            }),
            Rule(".chimera-menu a:hover", {
                color = token("text"),
                text_decoration = "none",
            }),
            Rule(".chimera-menu .chimera-theme-switcher", { margin_left = "auto" }),
            Rule(".chimera-menu .chimera-search", {
                flex = "0 1 15rem",
                min_width = "5rem",
                margin_left = "auto",
            }),
            -- The menu's links don't wrap, so the search box gives up the width when the bar gets tight.
            Rule(".chimera-menu .chimera-search-input", {
                box_sizing = "border-box",
                width = "100%",
            }),
            Rule(".chimera-menu .chimera-search ~ .chimera-theme-switcher", { margin_left = "0" }),
            Rule(".chimera-search", {
                position = "relative",
                margin = "0",
            }),
            Rule(".chimera-search-input", {
                width = "15rem",
                padding = "0.4rem 0.85rem",
                font = "inherit",
                font_size = "0.9rem",
                color = token("text"),
                background = token("surface"),
                border = border,
                border_radius = "999px",
                transition = "border-color 0.15s",
            }),
            Rule(".chimera-search-input::placeholder", { color = token("muted") }),
            Rule(".chimera-search-input:focus", {
                outline = "none",
                border_color = token("primary"),
            }),
            Rule(".chimera-search-results", {
                position = "absolute",
                top = "calc(100% + 0.4rem)",
                right = "0",
                z_index = "45",
                width = "min(34rem, calc(100vw - 2rem))",
                max_height = "70vh",
                overflow_y = "auto",
                padding = "0.35rem",
                font_size = "0.9rem",
                line_height = "1.45",
                background = token("background"),
                border = border,
                border_radius = "10px",
                box_shadow = token("shadow"),
                scrollbar_color = `{token("border")} transparent`,
                scrollbar_width = "thin",
            }),
            Rule(".chimera-search-group", {
                padding = "0.5rem 0.6rem 0.2rem",
                font_size = "0.75rem",
                font_weight = "600",
                letter_spacing = "0.04em",
                text_transform = "uppercase",
                color = token("muted"),
            }),
            Rule(".chimera-search-result", {
                display = "grid",
                grid_template_columns = "1fr auto",
                column_gap = "0.75rem",
                padding = "0.45rem 0.6rem",
                border_radius = "6px",
                color = token("text"),
            }),
            Rule(".chimera-search-result:hover, .chimera-search-result[aria-selected=\"true\"]", {
                background = token("surface"),
                text_decoration = "none",
            }),
            Rule(".chimera-search-title", {
                font_weight = "600",
                overflow_wrap = "anywhere",
            }),
            Rule(".chimera-search-kind", {
                font_family = token("mono_font"),
                font_size = "0.75rem",
                color = token("muted"),
            }),
            Rule(".chimera-search-where, .chimera-search-snippet", {
                grid_column = "1 / -1",
                font_size = "0.82rem",
                color = token("muted"),
            }),
            Rule(".chimera-search-snippet", {
                overflow = "hidden",
                text_overflow = "ellipsis",
                white_space = "nowrap",
            }),
            Rule(".chimera-search mark", {
                color = "inherit",
                background = `color-mix(in srgb, {token("primary")} 28%, transparent)`,
                border_radius = "2px",
            }),
            Rule(".chimera-search-empty", {
                padding = "0.6rem",
                color = token("muted"),
            }),
            Rule(".chimera-menu-toggle", {
                display = "none",
                align_items = "center",
                padding = "0.35rem",
                color = token("text"),
                background = "none",
                border_radius = "6px",
            }),
            Rule(".chimera-menu-toggle:hover", {
                filter = "none",
                transform = "none",
                background = token("surface"),
            }),
            Rule("@media (max-width: 700px)", {}, {
                Rule(".chimera-menu", {
                    flex_wrap = "wrap",
                    gap = "0.6rem 1rem",
                }),
                Rule(".chimera-menu-toggle", {
                    display = "inline-flex",
                    order = 2,
                    margin_left = "auto",
                }),
                Rule(".chimera-menu:has(.chimera-theme-switcher) .chimera-menu-toggle", { margin_left = "0" }),
                Rule(".chimera-menu .chimera-brand", { order = 0 }),
                Rule(".chimera-menu .chimera-theme-switcher", { order = 1 }),
                Rule(".chimera-menu .chimera-search", {
                    order = 1,
                    flex = "1 1 8rem",
                }),
                Rule(".chimera-menu .chimera-search-input", { width = "100%" }),
                Rule(".chimera-menu .chimera-search", { position = "static" }),
                Rule(".chimera-menu .chimera-search-results", {
                    top = "calc(100% + 0.25rem)",
                    left = "0.75rem",
                    right = "0.75rem",
                    width = "auto",
                }),
                Rule(`.chimera-menu > {folded_items}`, {
                    display = "none",
                    order = 3,
                    flex_basis = "100%",
                }),
                Rule(`.chimera-menu[data-open] > {folded_items}`, { display = "block" }),
            }),
            Rule(".chimera-to-top", { display = "none" }),
            Rule("@media (max-width: 800px)", {}, {
                Rule(".chimera-to-top[data-visible]", {
                    position = "fixed",
                    right = "max(1rem, env(safe-area-inset-right))",
                    bottom = "max(1rem, env(safe-area-inset-bottom))",
                    z_index = "40",
                    display = "flex",
                    align_items = "center",
                    justify_content = "center",
                    width = "2.75rem",
                    height = "2.75rem",
                    padding = "0",
                    font_size = "1.2rem",
                    color = token("text"),
                    background = token("surface"),
                    border = border,
                    border_radius = "999px",
                    box_shadow = token("shadow"),
                }),
            }),
            Rule(".chimera-dropdown, .chimera-theme-switcher", {
                position = "relative",
                margin = "0",
                padding = "0",
                background = "none",
                border = "none",
            }),
            Rule(".chimera-dropdown > summary, .chimera-theme-switcher > summary", {
                list_style = "none",
                margin = "0",
            }),
            Rule(".chimera-dropdown > summary::-webkit-details-marker", { display = "none" }),
            Rule(".chimera-theme-switcher > summary::-webkit-details-marker", { display = "none" }),
            Rule(".chimera-dropdown > summary", {
                color = token("muted"),
                font_weight = "500",
            }),
            Rule(".chimera-dropdown > summary::after", {
                content = "\"▾\"",
                margin_left = "0.35em",
                font_size = "0.8em",
            }),
            Rule(".chimera-dropdown > summary:hover", { color = token("text") }),
            -- A linked label follows its link. The arrow after it opens the list and gets a bigger target.
            Rule(".chimera-dropdown-linked > summary::after", { content = "none" }),
            Rule(".chimera-dropdown-linked > summary", {
                display = "inline-flex",
                align_items = "center",
                white_space = "nowrap",
            }),
            Rule(".chimera-dropdown-linked > summary > a", { color = "inherit" }),
            Rule(".chimera-dropdown-arrow::after", { content = "\"▾\"" }),
            Rule(".chimera-dropdown-arrow", {
                display = "inline-grid",
                place_items = "center",
                min_width = "1.6rem",
                height = "1.6rem",
                margin_left = "0.1rem",
                border_radius = "4px",
                font_size = "1.05em",
                cursor = "pointer",
            }),
            Rule(".chimera-dropdown-arrow:hover", { background = token("surface") }),
            Rule(".chimera-dropdown[open] > summary, .chimera-theme-switcher[open] > summary", { margin_bottom = "0" }),
            Rule(".chimera-dropdown-items, .chimera-theme-options", {
                position = "absolute",
                z_index = "40",
                min_width = "11rem",
                margin_top = "0.4rem",
                padding = "0.25rem",
                display = "flex",
                flex_direction = "column",
                font_size = "0.875rem",
                background = token("background"),
                border = border,
                border_radius = "8px",
                box_shadow = token("shadow"),
            }),
            Rule(".chimera-theme-options", { right = "0" }),
            Rule(".chimera-dropdown-items > *", {
                padding = "0.3rem 0.5rem",
                border_radius = "4px",
                color = token("text"),
            }),
            Rule(".chimera-dropdown-items > *:hover", {
