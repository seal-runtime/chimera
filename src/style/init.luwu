--!strict
--!optimize 2

export .{
    Style,
    Rule,
} = require("@self/style")

export .{
    Color,
} = require("@self/color")

export .{
    Theme,
    Palette,
} = require("@self/theme")

export .{
    Token,
    token,
} = require("@self/token")

const style = require("@self/style")
export type .{
    StyleInput,
    StyleValue,
} = style

const properties = require("@self/properties")
export type .{
    GlobalKeyword,
    CssText,
    Length,
    ColorValue,
    CssLength,
    CssColor,
    Display,
    Position,
    Overflow,
    Visibility,
    BoxSizing,
    Float,
    FlexDirection,
    FlexWrap,
    ContentAlignment,
    ItemAlignment,
    GridAutoFlow,
    FontWeight,
    FontStyle,
    TextAlign,
    TextTransform,
    TextOverflow,
    WhiteSpace,
    WordBreak,
    OverflowWrap,
    Hyphens,
    VerticalAlign,
    ListStylePosition,
    BorderStyle,
    BorderCollapse,
    TableLayout,
    Clip,
    BackgroundRepeat,
    Cursor,
    PointerEvents,
    UserSelect,
    ObjectFit,
    ScrollBehavior,
    Resize,
    Appearance,
    Isolation,
    FontSmoothing,
} = properties

const token_module = require("@self/token")
export type .{
    TokenName,
} = token_module

const theme = require("@self/theme")
export type .{
    ThemeMode,
} = theme
const color = require("@self/color")
export type .{
    NamedColor,
    AnsiLayer,
} = color
