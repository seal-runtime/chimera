--!strict
--!optimize 2
--!lint ConstLocal

const json = require("@std/json")
const markup = require("@core/markup")
const .{ Element, Text, Comment, Tag, Shape } = require("@core/markup")
const .{ Parser } = require("@parse/parser")
const .{ Document } = require("@document/document")
type .{ Markup } = markup

--- One attribute of a [JsonNode], in the order the element renders it. `true` is an attribute without a value.
export type JsonAttribute = {
    name: string,
    value: string | boolean,
}

--[=[
    One node of chimera's JSON: an element, text or a comment. An element has a `tag`, the component it is in
    `element` when it's one, its `attributes` and `children`. Text has `text` and a comment has `comment`.

    ```json
    { "tag": "div", "element": "Card", "attributes": [{ "name": "class", "value": "chimera-card" }],
      "children": [{ "tag": "h3", "children": [{ "text": "Fast" }] }] }
    ```
]=]
export type JsonNode = {
    tag: string?,
    element: string?,
    attributes: { JsonAttribute }?,
    children: { JsonNode }?,
    text: string?,
    comment: string?,
}

const function tree_of(node: Markup): JsonNode
    if class.isinstance(node, Text) then
        return { text = node.content }
    elseif class.isinstance(node, Comment) then
        return { comment = node.text }
    elseif not class.isinstance(node, Tag) then
        return { text = node:to_html() }
    end
    const attributes: { JsonAttribute } = {}
    local element: string? = nil
    for _, name in node.attributes.names do
        const value = node.attributes.values[name]
        if name == "data-element" and type(value) == "string" then
            element = value
        elseif value ~= nil then
            table.insert(attributes, {
                name = name,
                value = value,
            })
        end
    end
    for _, name in { "class", "style" } do
        if const value = node:get_attr(name) then
            table.insert(attributes, {
                name = name,
                value = value,
            })
        end
    end
    const children = { for _, child in node:child_nodes() give tree_of(child) }
    return {
        tag = node:current_tag(),
        element = element,
        attributes = if #attributes > 0 then attributes else nil,
        children = if #children > 0 then children else nil,
    }
end

const function build(tree: JsonNode, warnings: { string }): Markup?
    if const text = tree.text then
        return Text(text)
    elseif const comment = tree.comment then
        return Comment(comment)
    end
    const tag = tree.tag or do
        table.insert(warnings, "a node has no tag, text or comment; dropped it")
        give nil
    if not tag then
        return nil
    end
    const element = Element.create(tag, tree.element):reset()
    for _, attribute in tree.attributes or {} do
        element:attr(attribute.name, attribute.value)
    end
    for _, child in tree.children or {} do
        if const node = build(child, warnings) when not element:adopt(node) then
            table.insert(warnings, `{class.name(element)} can't hold {node:outline()}; dropped it`)
        end
    end
    return element
end

--[=[
    chimera's nodes as JSON, for tools that read or write pages without parsing HTML. The JSON is the same tree as
    the node's HTML: what [Json.encode] writes, [Json.decode] reads back as the same nodes, components included,
    the way the [Parser] reads HTML. Registered [Shape][markup.Shape]s are recognized in what it reads.

    [markup = require("@core/markup")]

    ```luwu
    const text = Json.encode(page, true)
    const again = Json.decode_document(text)
    ```
]=]
export class Json
    --[=[
        `node` as a [JsonNode] table, before it's turned into text. Tools that work on tables use this.

        ## Usage

        ```luwu
        const tree = Json.tree(Paragraph({ "Hi ", Strong("there") }))
        print(tree.tag, #(tree.children or {}))
        ```
    ]=]
    function tree(node: Markup): JsonNode
        const roots = Parser():parse_tree(node:to_html())
        if #roots == 1 then
            return tree_of(roots[1])
        end
        return {
            tag = "#fragment",
            children = { for _, root in roots give tree_of(root) },
        }
    end

    --[=[
        `node` as JSON text, indented when `pretty` is true.

        ## Usage

        ```luwu
        fs.writefile("page.json", Json.encode(site:document(page), true))
        ```
    ]=]
    function encode(node: Markup, pretty: boolean?): string
        const tree = Json.tree(node)
        -- Records are a kind of table json can encode, but the type system only takes maps here.
        const data = tree :: json.JsonData
        return if pretty then json.encode(data, { pretty = true }) else json.raw(data)
    end

    --[=[
        Reads JSON written by [Json.encode], or a list of nodes, back into chimera nodes. A `"#fragment"` node
        stands for its children. Also returns the problems that didn't stop reading, like a child its parent
        can't hold.

        ## Usage

        ```luwu
        for _, node in Json.decode(fs.readfile("card.json")) do
            print(node)
        end
        ```
    ]=]
    function decode(text: string, recognize_shapes: boolean = true): ({ Markup }, { string })
        return Json.build(json.decode(text) :: JsonNode | { JsonNode }, recognize_shapes)
    end

    --[=[
        Builds chimera nodes from [JsonNode] tables, the way [Json.decode] does with text.

        ## Usage

        ```luwu
        Json.build({ tag = "p", children = { { text = "Hi" } } })
        ```
    ]=]
    function build(tree: JsonNode | { JsonNode }, recognize_shapes: boolean = true): ({ Markup }, { string })
        const warnings: { string } = {}
        const single = tree :: JsonNode
        const list: { JsonNode } = if single.tag == "#fragment"
            then single.children or {}
            elseif single.tag or single.text or single.comment then { single }
            else tree :: { JsonNode }
        const nodes = {
            for _, item in list
            when const node = build(item, warnings)
            give if recognize_shapes then Shape.recognize_all(node) else node
        }
        return nodes, warnings
    end

    --[=[
        Reads a whole page written by [Json.encode]. Content outside an `html` node goes into a new document's
        body.

        ## Usage

        ```luwu
        const page = Json.decode_document(fs.readfile("index.json"))
        fs.writefile("index.html", page:to_html(true))
        ```
    ]=]
    function decode_document(text: string): Document
        local document: Document? = nil
        const loose: { Markup } = {}
        for _, node in Json.decode(text) do
            if class.isinstance(node, Document) then
                document = node
            else
                table.insert(loose, node)
            end
        end
        const result: Document = document or Document()
        for _, node in loose do
            result.body:adopt(node)
        end
        return result
    end
end
