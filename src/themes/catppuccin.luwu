--!strict
--!optimize 2
--!lint ConstLocal

const .{ Color } = require("@style/color")
const .{ Theme, Palette } = require("@style/theme")

--[=[
    A Catppuccin flavor: a [Theme] built from Catppuccin's 26 named colors (https://catppuccin.com/palette).
    The colors default to Mocha's; each flavor overrides them, and its palette follows.

    ## Usage

    Use a flavor as a theme, or read its colors:

    ```luwu
    page
        :default_dark_theme(catppuccin.Mocha)
        :default_light_theme(catppuccin.Latte)
    Div("Note"):style({ border_left = `3px solid {catppuccin.Mocha().peach}` })
    ```

    Make your own flavor by overriding the colors that change:

    ```luwu
    class Midnight() implements catppuccin.Flavor
        const name = "midnight"
        const mode = "Dark"
        base = Color.hex("#0b0b12")
        mantle = Color.hex("#08080d")
    end
    ```
]=]
export trait Flavor needs Theme
    rosewater = Color.hex("#f5e0dc")
    flamingo = Color.hex("#f2cdcd")
    pink = Color.hex("#f5c2e7")
    mauve = Color.hex("#cba6f7")
    red = Color.hex("#f38ba8")
    maroon = Color.hex("#eba0ac")
    peach = Color.hex("#fab387")
    yellow = Color.hex("#f9e2af")
    green = Color.hex("#a6e3a1")
    teal = Color.hex("#94e2d5")
    sky = Color.hex("#89dceb")
    sapphire = Color.hex("#74c7ec")
    blue = Color.hex("#89b4fa")
    lavender = Color.hex("#b4befe")
    text = Color.hex("#cdd6f4")
    subtext1 = Color.hex("#bac2de")
    subtext0 = Color.hex("#a6adc8")
    overlay2 = Color.hex("#9399b2")
    overlay1 = Color.hex("#7f849c")
    overlay0 = Color.hex("#6c7086")
    surface2 = Color.hex("#585b70")
    surface1 = Color.hex("#45475a")
    surface0 = Color.hex("#313244")
    base = Color.hex("#1e1e2e")
    mantle = Color.hex("#181825")
    crust = Color.hex("#11111b")
    --- The box shadow every element uses, as CSS.
    shadow = "0 1px 3px rgb(17 17 27 / 0.6)"

    --[=[
        Maps the flavor's colors onto chimera's tokens: mauve is the primary color and peach the accent. Code is
        highlighted the way Catppuccin's own syntax themes do: mauve keywords, green strings, blue functions.
    ]=]
    function palette(self): Palette
        return Palette {
            background = self.base,
            surface = self.mantle,
            text = self.text,
            muted = self.subtext0,
            primary = self.mauve,
            primary_text = self.base,
            accent = self.peach,
            border = self.surface0,
            shadow = self.shadow,
            syntax_keyword = self.mauve,
            syntax_string = self.green,
            syntax_number = self.peach,
            syntax_comment = self.overlay2,
            syntax_function = self.blue,
            syntax_type = self.yellow,
            syntax_builtin = self.red,
            syntax_constant = self.peach,
            syntax_bracket_1 = self.maroon,
            syntax_bracket_2 = self.teal,
            syntax_bracket_3 = self.lavender,
            syntax_error = self.red,
            syntax_warning = self.yellow,
            syntax_info = self.blue,
        }
    end
end

--- The Catppuccin Latte theme, the light flavor.
