--!strict
--!optimize 2
--!lint ConstLocal

const fs = require("@std/fs")
const chimera = require("@chimera")
const .{
    Component,
    Container,
    elements.{ Header, Section, Heading, Paragraph, Link, Div, UnorderedList, ListItem },
    style.{ Rule, token },
    themes.{ Light, Dark, catppuccin },
    components.{ Menu, Dropdown, ThemeSwitcher, CodeBlock, Code, Tabs, Tab, Toggle, Grid, Row, SourceSpan, Squiggle },
    site.{ Site, Page, PageLink },
} = chimera
type .{ Content } = chimera
const .{ examples_in } = require("./guide/example")
const .{ h1, h2, h3 } = Heading

--- The top of the home page: what chimera is, in one heading and one paragraph, with links to start.
class Intro implements Component, Container
    function tag(): string
        return "section"
    end

    function __init(self, title: string?, summary: Content?, features: { read ListItem | string }?, actions: Content?)
        self:add(
            h1(title),
            Paragraph(summary):add_style_class("summary"),
            UnorderedList(features):add_style_class("features"),
            Row(actions)
                :gap("0.75rem")
                :add_style_class("actions")
        )
    end

    function default_styles(self): { Rule }
        const intro = self:style_selector()
        return {
            Rule(intro, {
                max_width = "44rem",
                padding = "3.5rem 0 1rem",
            }),
            Rule(`{intro} h1`, {
                margin = "0 0 1rem",
                font_size = "clamp(2.4rem, 6vw, 3.4rem)",
                letter_spacing = "-0.02em",
            }),
            Rule(`{intro} .summary`, {
                color = token("muted"),
                font_size = "1.2rem",
            }),
            Rule(`{intro} .features`, {
                margin = "0.75rem 0 0",
                padding_left = "1.25rem",
            }),
            Rule(`{intro} .features li`, { margin = "0.3rem 0" }),
            Rule(`{intro} .actions`, { margin_top = "1.5rem" }),
            Rule(`{intro} .actions a`, {
                padding = "0.55em 1.1em",
                color = token("text"),
                font_weight = "600",
                border = `1px solid {token("border")}`,
                border_radius = token("radius"),
            }),
            Rule(`{intro} .actions a:hover`, {
                text_decoration = "none",
                border_color = token("primary"),
            }),
            Rule(`{intro} .actions a.primary`, {
                background = token("primary"),
                color = token("primary_text"),
                border_color = token("primary"),
            }),
        }
    end
end

Component.register(Intro)

const SOURCE = "https://github.com/seal-runtime/chimera"
const example = examples_in("examples/site.luwu")
const guide = require("./guide")
const luwu_pages = require("./luwu/index")
const home = Page("Home", nil, "index.html")

--@ release notes
const install = Tabs({
    Tab("Linux", CodeBlock("curl -fsSL https://example.com/install.sh | sh", "bash")),
    Tab("Windows", CodeBlock("winget install example", "shell")),
})
const changes = Paragraph("Saves load twice as fast. Old saves still work.")

const notes = Section {
    h3("Version 2.0"),
    Paragraph("Released October 2026."),
    install,
    Row({ Toggle("What changed?", changes), Link("Full changelog", "#") }):align("center"),
    changes:hidden(),
}
--@ end

--- A guide page with the one line that says what it covers.
const function topic(page: Page, summary: string): Div
    return Div({ PageLink(page), Paragraph(summary) }):add_style_class("topic")
end

const function guide_page(path: string): Page
    for _, page in guide:all_pages() do
        if page:path() == path then
            return page
        end
    end
    return error(`no guide page at {path}`)
end

home:add(
    Intro("chimera", {
        "chimera is a library for building static websites in Luwu. It turns pages made of classes like ",
        Code("Paragraph"), ", ", Code("Menu"), " and ", Code("CodeBlock"), " into ready-to-publish HTML.",
    }, {
        ListItem("Light and dark themes, Catppuccin flavors and a theme switcher"),
        ListItem("Menus, tabs, toggles, cards and layouts, all styled by the theme"),
        ListItem("Luwu, Luau and Lua highlighted at build time, with squiggles and hovers"),
        ListItem("Typed styles that the Luwu analyzer checks as you write them"),
        ListItem("HTML that roundtrips into the same objects, to keep editing in Luwu"),
    }, {
        PageLink(guide, "Get started"):add_style_class("primary"),
        Link("Source on GitHub", "https://github.com/seal-runtime/chimera"):new_tab(),
    }),

    h2("A quick look"),
    Paragraph({
        "Here's a small release notes section, with the code that builds it underneath. The tabs, the ",
        "\"What changed?\" toggle and all of the colors come with chimera and follow whichever theme you pick, ",
        "and you didn't have to write any CSS or JavaScript for them.",
    }),
    example("release notes", notes),

    h2("Checked by default"),
    Paragraph({
        "Luwu type checks in strict mode by default, and chimera describes CSS values with Luwu's type function ",
        "validators. The analyzer checks every style you write against them. A wrong unit or a misspelled ",
        "keyword shows up in your editor before you ever build the page. Hover the squiggles:",
    }),
    CodeBlock([====[const .{ elements.{ Paragraph }, components.{ Card } } = require("@chimera")

const note = Card("Heads up", Paragraph("Back up your saves."))
    :style({ padding = "1rx", display = "flexx" })]====])
        :line_numbers()
        :squiggle(
            Squiggle.error(SourceSpan.on_line(4, 24, 28), "TypeError: CSS length '1rx' has the unknown unit 'rx'"),
            Squiggle.error(SourceSpan.on_line(4, 41, 47), "Typo: Did you mean '\"flex\"' instead of '\"flexx\"'?")
        ),
    Paragraph({ "Both messages come straight from ", Code("luwu-analyze", "bash"), "." }),

    h2("Where to go next"),
    Grid({
        topic(guide_page("guide/sites-and-pages.html"), "Pages, nested folders, links and tables of contents."),
        topic(guide_page("guide/components.html"), "Menus, dropdowns, tabs, toggles, cards and a theme switcher."),
        topic(guide_page("guide/code.html"), "Luwu highlighting at build time, squiggles and hovers."),
        topic(guide_page("guide/theming.html"), "Light and dark defaults, Catppuccin, and themes of your own."),
        topic(guide_page("guide/styling.html"), "Typed CSS that reads theme tokens."),
        topic(guide_page("guide/custom-components.html"), "Your own components, written once as classes."),
    }, "16rem"),

    Paragraph({
        "This site is built with chimera. Its source is ",
        Link(Code("examples/site.luwu", "plaintext"), `{SOURCE}/blob/main/examples/site.luwu`):new_tab(),
        ".",
    }):add_style_class("built-with")
)

const website = Site("chimera")
    :default_dark_theme(catppuccin.Mocha)
    :default_light_theme(catppuccin.Latte)
    :offer_theme(catppuccin.Macchiato)
    :offer_theme(catppuccin.Frappe)
    :offer_theme(Light)
    :offer_theme(Dark)
    :describe("Build static websites in Luwu, from classes")
    :header(Header {
        Menu {
            PageLink(home, "chimera"):add_style_class("chimera-brand"),
            PageLink(guide),
            PageLink(luwu_pages),
            Dropdown("More", {
                Link("Source", "https://github.com/seal-runtime/chimera"):new_tab(),
                Link("Luwu", "https://github.com/luwu-community/luwu"):new_tab(),
                Link("seal", "https://github.com/seal-runtime/seal"):new_tab(),
            }),
            ThemeSwitcher(),
        },
    })
    :footer(chimera.components.SiteFooter()
        :link_column("Learn", {
            PageLink(guide, "Getting started"),
            PageLink(guide_page("guide/components.html")),
            PageLink(guide_page("guide/theming.html")),
            PageLink(luwu_pages, "Luwu"),
        })
        :link_column("Project", {
            Link("Source", "https://github.com/seal-runtime/chimera"):new_tab(),
            Link("Luwu", "https://github.com/luwu-community/luwu"):new_tab(),
            Link("seal", "https://github.com/seal-runtime/seal"):new_tab(),
        })
        :copyright("seal-runtime", "Built with chimera in Luwu.")
        :legal({ Link("License", "https://github.com/seal-runtime/chimera/blob/main/LICENSE"):new_tab() })
    )
    :style_every(".topic a", { font_weight = "600" })
    :style_every(".topic p", {
        margin = "0.25rem 0 0",
        color = token("muted"),
    })
    :style_every(".built-with", {
        margin_top = "3rem",
        color = token("muted"),
    })
    :add_page(home, guide, luwu_pages)

for _, path in website:build("examples/out") do
    print(`wrote {path}`)
end

const assets = {
    { file = "nyla-nyeh.png", destination = "luwu/nyla-nyeh.png" },
}
for _, .{ file, destination } in assets do
    fs.copy(`examples/assets/{file}`, `examples/out/{destination}`)
    print(`copied examples/out/{destination}`)
end
