--!strict
--!optimize 2
--!lint ConstLocal

const .{
    elements.{ Heading, Paragraph },
    components.{ Code, CodeBlock },
    site.{ Page, TableOfContents },
} = require("@chimera")
const luwu = require("./sample")
const .{ h1, h2 } = Heading

return Page("More Conveniences", {
    h1("More Conveniences"),
    Paragraph("Luwu also adds a few smaller conveniences for everyday code."),
    TableOfContents(),

    h2("Named functions in table literals"),
    Paragraph("In Luau, a function stored in a table is a key assigned an anonymous function:"),
    luwu([====[
        local handlers = {
            on_start = function()
                print("started")
            end,
        }
        handlers.on_start()
    ]====]),
    Paragraph({
        "In Luwu, you can declare it like any other function, with ", Code("function name()"),
        " right inside the table:",
    }),
    luwu([====[
        const handlers = {
            function on_start()
                print("started")
            end,
            function on_stop()
                print("stopped")
            end,
        }

        handlers.on_start()
        handlers.on_stop()
    ]====]),
    Paragraph({
        "It reads the same as a ", Code("const function"), " or a class method. ",
        "A table of functions looks like the rest of your code.",
    }),
    Paragraph("A function without a name is still a list item, like in Luau."),
    h2("Importing classes with their types"),
    Paragraph("In Luau, a value and a type are imported separately. A class-like table needs both lines:"),
    CodeBlock([====[local shapes = require("./shapes")
local Circle = shapes.Circle
type Circle = shapes.Circle]====], "luau"),
    Paragraph("A Luwu class is a value and a type at once. Given a module that exports one:"),
    CodeBlock([====[export class Circle(radius: number)
    function area(self): number
        return math.pi * self.radius ^ 2
    end
end]====]),
    Paragraph("Importing the class brings its type along, whichever way you import it:"),
    CodeBlock([====[const shapes = require("./shapes")
const Circle = shapes.Circle]====]),
    CodeBlock([====[const .{ Circle } = require("./shapes")

const function describe(circle: Circle): string
    return `a circle with area {circle:area()}`
end]====]),
    Paragraph({ "Traits work the same way. ", Code("type Circle = shapes.Circle"), " still works, but isn't needed." }),
}, "more-conveniences.html")
