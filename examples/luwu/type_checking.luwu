        }),
        checked(
            [====[--!strict
type EnemyImpl = {
    __index: EnemyImpl,
    new: (name: string, health: number) -> Enemy,
    take_damage: (self: Enemy, amount: number) -> boolean,
}
export type Enemy = typeof(setmetatable({} :: { name: string, health: number }, {} :: EnemyImpl))

type BossImpl = EnemyImpl & {
    phase: (self: Boss) -> number,
}
export type Boss = typeof(setmetatable({} :: { name: string, health: number, enraged: boolean }, {} :: BossImpl))

local Enemy = {} :: EnemyImpl
local Boss = setmetatable({}, { __index = Enemy }) :: BossImpl

Boss.take_damage = function(self: Boss, amount: number): number
    self.health -= amount
    return self.health
end]====],
