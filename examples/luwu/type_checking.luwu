            [====[main.luau(4,21): TypeError: Table type '{ levl: number, name: string }' not compatible with type 'Player' because the former is missing field 'level']====],
            { "4.37-4.40", "" },
            [====[main.luau(4,37): Typo: Did you mean 'level' instead of 'levl'?
main.luau(4,21): TypeError: 'ada' is missing a property for 'Player':
  • 'level: number']====]
        ),
