--!strict
--!optimize 2
--!lint ConstLocal

const .{
    elements.{ Heading, Paragraph, UnorderedList, ListItem, Details, Figure, FigureCaption, Image, Emphasis },
    components.{ Code, CodeBlock, SourceSpan, Squiggle, Tabs, Tab },
    site.{ Page, TableOfContents },
    style.{ token },
} = require("@chimera")
const str = require("@std/str")
const luwu = require("./sample")
const .{ h1, h2, h3 } = Heading

--- Each diagnostic in an analyzer's output, without its `main.luau(line,column): ` location.
const function diagnostics(output: string): { string }
    const found: { { string } } = {}
    for _, line in str.splitlines(output) do
        if const message = string.match(line, "^main%.luau%(%d+,%d+%): (.*)$") then
            table.insert(found, { message })
        elseif #found > 0 then
            table.insert(found[#found], line)
        end
    end
    return { for _, lines in found give (string.gsub(table.concat(lines, "\n"), "%s+$", "")) }
end

--- `source` as one checker sees it: its messages on squiggles under `spans`, then its whole output.
const function checker_view(source: string, spans: { string }, output: string): { CodeBlock }
    const messages = diagnostics(output)
    const squiggles = {
        for index, span in spans
        when span ~= ""
        when const message = messages[index]
        give do
            const kind, rest = string.match(message, "^(%a+): (.*)$")
            const text = rest or message
            const where = SourceSpan.from_string(span)
            give if kind == "Note" or str.startswith(text, "Help")
                then Squiggle.info(where, text)
                else Squiggle.error(where, text)
    }
    return {
        CodeBlock(source, "luau")
            :line_numbers()
            :copyable()
            :squiggle(table.unpack(squiggles)),
        CodeBlock(if output == "" then "No errors." else output, "plaintext")
            :copyable()
            :style({ white_space = "pre-wrap" }),
    }
end

--- One example, collapsed until the reader opens it.
const function example(title: string, content: { Paragraph | Tabs }): Details
    return Details(title, content):style({ background = token("background") })
end

--- An example with a tab for each checker's diagnostics, Luwu's first.
const function checked(
    source: string,
    luau_spans: { string },
    luau_output: string,
    luwu_spans: { string },
    luwu_output: string
): Tabs
    return Tabs({
        Tab("Luwu", checker_view(source, luwu_spans, luwu_output)),
        Tab("Luau 0.742", checker_view(source, luau_spans, luau_output)),
    })
end

return Page("Type Checking", {
    h1("Type Checking"),
    Paragraph({
        "By default, Luwu type checks your code in strict mode and reports mistakes in your editor as you write them. ",
        "A file that needs to can opt out of strict checking. ",
        "Values are still dynamically typed at runtime, and typing is gradual: you can start from untyped code, ",
        "add type annotations a piece at a time and let inference handle most of the rest.",
    }),
    TableOfContents(),

    h2("Catching mistakes"),
    Paragraph("A typo in a field name is a type error, reported where you made it:"),
    CodeBlock([====[type Player = { name: string, level: number }

const function promote(player: Player)
    player.level += 1
end

promote({ name = "Ada", levl = 3 })]====])
        :line_numbers()
        :squiggle(Squiggle.error(SourceSpan.on_line(7, 25, 28), "Typo: Did you mean 'level' instead of 'levl'?")),
    CodeBlock([====[Typo: Did you mean 'level' instead of 'levl'?
TypeError: The given table is missing a property for 'Player':
  • 'level: number']====], "plaintext"),
    Paragraph("Without the checker, this program would fail later, when something reads the missing level."),

    h2("Inference"),
    Paragraph("Most code needs few annotations. Luwu infers the types of locals, return values and tables for you:"),
    luwu([====[
        const function average(numbers: { number })
            local total = 0
            for _, n in numbers do
                total += n
            end
            return total / #numbers
        end

        const result = average({ 4, 8, 15 })
        print(result)
    ]====]):line_numbers(),
    Paragraph({
        "Here only the parameter is annotated. ", Code("total"), " and the return value are inferred as numbers, ",
        "and ", Code("result"), " is a number too.",
    }),

    h2("Gradual typing"),
    Paragraph("Untyped code still runs and still type checks. Its parameters accept anything until you annotate them:"),
    luwu([====[
        const function label(name, count)
            return `{name} x{count}`
        end

        print(label("Potion", 3))
    ]====]):line_numbers(),
    Paragraph("Adding annotations later tightens the checks without changing how the code runs:"),
    luwu([====[
        const function label(name: string, count: number): string
            return `{name} x{count}`
        end

        print(label("Potion", 3))
    ]====]):line_numbers(),
    Paragraph({
        "To opt a file out of strict checking, put ", Code("--!nonstrict"), " or ", Code("--!nocheck"),
        " on its first line.",
    }),

    h2("Annotations and the compiler"),
    Paragraph({
        "Type annotations also inform the compiler. Upstream Luau already uses them as optimization hints. ",
        "Luwu goes further: in a file marked ", Code("--!trust"), ", the compiler relies on annotations to inline ",
        "methods, and an annotation that doesn't match the actual value becomes a runtime error.",
    }),

    h2("Error messages"),
    Paragraph({
        "Luau's type errors describe where the checker's subtyping test failed. ",
        "Luwu's describe the mistake in terms of your code: the variable's name, the path to the bad property, ",
        "and how to fix it when there's a common fix.",
    }),
    Paragraph({
        "We purposely limit jargon in type errors. Terms like subtyping, variance or invariance stay out of a ",
        "message unless it can't be understood without them. And when one is needed, we like to attach a ",
        "\"Help\" explanation to describe what the term is and why we've flagged your code because of it.",
    }),
    Figure({
        Image("nyla-nyeh.png", "Nyla, the Luwu cat, lying on her back with her paws up, saying \"nyeh...\"")
            :style({ border_radius = token("radius") }),
        FigureCaption({
            "Nyla finding a recursive ", Emphasis("CYCLE"), " in her fancatstic library. ",
            "Art by Cat! (@meowzer_meow on Discord)",
        }),
    }):style({ max_width = "22rem", margin = "1.5rem auto", text_align = "center" }),
    Paragraph({
        "Luwu names things the way your code does. Where Luau says \"this\" or expands a whole ",
        "expanded type, Luwu uses the variable's name or the path to the property (like ", Code("stool.inputs[i].count"),
        "), or the type's alias.",
    }),
    Paragraph({
        "Where possible, Luwu will try to add blue 'Info' notes (spans) to error messages to help you track down the ",
        "root cause of a property mismatch, following it through multiple variables if needed. This means you don't have ",
        "to manually trace error string paths back to where they came from."
    }),
    Paragraph({
        "The examples below were checked with upstream Luau 0.742's ", Code("luau-analyze"), " and with ",
        Code("luwu-analyze"), ". The output is unedited apart from the file name.",
    }),

    h3("Typos"),
    Paragraph({
        "Luwu looks for typos wherever a name or a string is checked against a known set: locals, globals, ",
        "properties, methods, library functions, type names, string literals and tagged union tags. ",
        "Luau reports most of these as something else, like a missing property, or not at all.",
    }),
    example("Misspelled locals", {
        Paragraph("A misspelled local:"),
        checked(
            [====[--!strict
local player_name = "Ada"
print(player_nmae)]====],
            { "3.7-3.17" },
            [====[main.luau(3,7): TypeError: Unknown global 'player_nmae'; consider assigning to it first]====],
