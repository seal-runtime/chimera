--!strict
--!optimize 2
--!lint ConstLocal

const .{
    elements.{ Heading, Paragraph, UnorderedList, ListItem, Link },
    components.{ Code, CodeBlock },
    site.{ Page, PageLink, TableOfContents },
} = require("@chimera")
const str = require("@std/str")
const luwu = require("./sample")
const .{ sample, terminal } = require("./terminal")
const .{ h1, h2, h3 } = Heading

const compatibility = require("./compatibility")
const type_checking = require("./type_checking")
const lints = require("./lints")
const hovers = require("./hovers")
const classes = require("./classes")
const control_flow = require("./control_flow")
const destructuring = require("./destructuring")
const comprehensions = require("./comprehensions")
const default_arguments = require("./default_arguments")
const none_page = require("./none")
const literal_types = require("./literal_types")
const library_extensions = require("./library_extensions")
const external_memory = require("./external_memory")
const experimental = require("./experimental")

const health = sample("health")
--- Where the whole Health example lives, on the Classes and Traits page.
const FULL_HEALTH_EXAMPLE = "luwu/classes-and-traits.html#protecting-invariants"

--[=[
    `source` cut down to its class header and the methods in `keep`. The other methods become one `-- ...` comment
    saying what they are, and the setup above the class is left out.
]=]
const function excerpt(source: string, keep: { [string]: boolean? }, note: string): string
    const lines: { string } = {}
    local started = false
    local skipping = false
    local noted = false
    for _, line in str.splitlines(source) do
        started = started or str.startswith(line, "class ")
        if not started then
            continue
        end
        if const name = string.match(line, "^    %a+ function ([%w_]+)%(") when not keep[name] then
            skipping = true
            if not noted then
                table.insert(lines, `    -- ... {note}`)
                noted = true
            end
        end
        if not skipping then
            table.insert(lines, line)
        end
        if skipping and line == "    end" then
            skipping = false
        end
    end
    return table.concat(lines, "\n")
end

--- A "See more" link to a feature's page.
const function see_more(page: Page): Paragraph
    return Paragraph({ PageLink(page, `See {page.title} →`) })
end

return Page("Luwu", {
    h1("Luwu"),
    Paragraph({
        "Luwu is a fast, object oriented, and highly expressive embeddable scripting language forked from Luau 0.730 ",
        "and influenced by Kotlin, Rust, Ruby, and Python.",
    }),
    Paragraph({
        "Luwu is designed around improving the developer experience, with a user-first type system focused on ",
        "surfacing useful hovers and error reporting in modern, industry standard editors, new features that make ",
        "everyday code easier to read and write, and incremental improvements that improve analysis in both existing ",
        "Luau as well as greenfield Luwu projects.",
    }),
    TableOfContents(),

    h2("What Luwu is for"),
    Paragraph("Luwu is built for code that models behavior and data, such as:"),
    UnorderedList({
        ListItem("gameplay scripting"),
        ListItem("data modeling"),
        ListItem("data transformation"),
        ListItem("tools and scripts that grow into real programs"),
    }),

    h2("Your first program"),
    Paragraph({
        "Luwu files end in ", Code(".luwu", "plaintext"), ". If you've written Luau, this short program should look ",
        "familiar. It keeps a small inventory, picks out the fruit that's in stock and prints it cheapest first:",
    }),
    luwu([====[
        type Item = { name: string, price: number, stock: number }

        const inventory: { Item } = {
            { name = "apple", price = 1.25, stock = 12 },
            { name = "pear", price = 0.8, stock = 0 },
            { name = "kiwi", price = 0.5, stock = 30 },
        }

        const in_stock = { for _, item in inventory when item.stock > 0 give item }
        table.sort(in_stock, function(a: Item, b: Item)
            return a.price < b.price
        end)

        for _, .{ name, price } in in_stock do
            print(`{name}: {price}`)
        end
    ]====]),
    Paragraph({
        "Most of it is the Luau you already know. The ",
        Code("{ for ... when ... give item }"), " line is a table comprehension: it builds the filtered array in a ",
        "single expression. In the second loop, ", Code("for _, .{ name, price }"), " uses destructuring to pull ",
        "just the fields you need out of each item. You don't need two more lines of code just to put ",
        Code("item.name"), " and ", Code("item.price"), " into local variables.",
    }),
    Paragraph({
        "Run ", Code("fruit.luwu", "plaintext"), " with ",
        Link("seal", "https://github.com/seal-runtime/seal/pull/295"):new_tab(), ", a Luau and Luwu runtime:",
    }),
    CodeBlock("seal ./fruit.luwu", "bash"):copyable(),
    CodeBlock("kiwi: 0.5\napple: 1.25", "plaintext"),

    h2("Luwu and Luau"),
    Paragraph({
        "Luwu was forked by the ", Link("Nyla, Hina & Ferris", "https://discord.gg/3MJ37CFNWh"):new_tab(),
        " Discord community to better suit our needs for general-purpose programming outside of Roblox.",
    }),
    Paragraph({
        "In addition to popular Luau features such as string interpolation, generalized iteration, compound ",
        "assignment operators, the new type solver (with type functions!), ", Code("const"), " syntax, ",
        Code("if local"), ", and more, Luwu code also features highly optimized classes and objects with code reuse ",
        "facilitated via traits, table/object/userdata destructuring, ", Code("do"), " expressions, table ",
        "comprehensions, the ", Code("none"), " primitive, externally managed buffers, and more.",
    }),
    Paragraph({
        "Since the fork, Luau and Luwu have diverged. The main differences today are in classes and ",
        "inheritance, integers, and destructuring.",
    }),
    see_more(compatibility),
    Paragraph("The sections below give a short tour of each feature."),

    h2("Types and editor support"),
    Paragraph({
        "We maintain our ", Link("LSP", "https://github.com/luwu-community/luwu-lsp/tree/luwu"):new_tab(),
        " and the Luwu VSCode/Code-OSS extension alongside the language. New editor features and type checking ",
        "improvements are developed directly against them, and we see how every change reads in a real editor ",
        "before it ships.",
    }),
    Paragraph({
        "That's also why Luwu prints types and errors differently from Luau. Luau is primarily developed against ",
        "Roblox's Studio script editor and stringifies types to fit the single-line diagnostics Studio shows. ",
        "Our language server targets VSCode/Code-OSS (with hopefully more editors coming soon!) where hovers and ",
        "diagnostics span several lines. Luwu prints types over multiple lines formatted like code and writes its ",
        "error messages for people reading them in a hover. ",
        "We've also added context to Luwu's type errors that makes them easier for tools to work with.",
    }),

    h3("Type Checking"),
    Paragraph({
        "Luwu enables type checking by default to catch your code's mistakes before you run it. ",
        "Luwu builds upon Luau's new type solver to add new features, drastically improve error message friendliness ",
        "and readability, and catch more common mistakes.",
    }),
    Paragraph({
        "Luwu type checking defaults to a relatively strict mode, but you can go back to the autocomplete-only Luau ",
        "default with ", Code("--!nonstrict"), " (or all the way to ", Code("--!nocheck"), " for untyped Lua code). ",
        "Note that due to popular demand, we surface typos even in ", Code("--!nonstrict"), ".",
    }),
    see_more(type_checking),

    h3("Literal Types and Validators"),
    Paragraph({
        "A literal type requires a value written directly at the call, such as ", Code("\"#3b5bdb\""), " or ",
        Code("\"1.5rem\""), ", and a validator is a type function that checks that literal during analysis. ",
        "Your own APIs can use them to reject a malformed color, size or route in the editor with an error ",
        "message you write yourself.",
    }),
    see_more(literal_types),

    h3("Lints"),
    Paragraph({
        "We also expand Luau's built-in lint system with more than 40 new lints for Luau and Luwu code, ",
        "to help you write more idiomatic and performant code.",
    }),
    see_more(lints),

    h3("Better Hovers"),
    Paragraph({
        "Our hovers target luwu-lsp and the Luwu VSCode/Code-OSS extension and significantly improve recursive ",
        "type stringification. A hover exposes every relevant type with verbosity levels and go to ",
        "location links you can click. Overloads and unions are serialized in a more readable way, and each type ",
        "with documentation attached shows one line of it above.",
    }),
    see_more(hovers),

    h2("Objects and data"),

    h3("Classes and Traits"),
    Paragraph({
        "A class represents a domain specific concept for your program, such as ", Code("Player"), " and ",
        Code("Health"), " classes in a game. In Luwu, you can use classes to abstract related functionality into ",
        "components that make sense and use traits to share functionality that multiple classes need to use.",
    }),
    Paragraph({
        "Classes are also great for representing data that needs to rely upon certain properties always valid, ",
        "such as health being clamped between 0 and ", Code("max_health"), ", age not being negative, positions not ",
        "being NaN, etc. This ", PageLink(FULL_HEALTH_EXAMPLE, { Code("Health"), " example" }),
        " represents the concept of health points and protects ",
        "the fact that health must always be valid, and has a nice healthbar display for when you print it out ",
        "to a terminal:",
    }),
    CodeBlock(excerpt(
        health.source,
        { full = true, clamped = true, __add = true, __sub = true },
        "comparisons (__eq, __lt, __le) and a healthbar __tostring"
    )),
    Paragraph({
        "The healthbar's colors come from seal's ", Code("@std/io/colors", "plaintext"), " library. Save the ",
        PageLink(FULL_HEALTH_EXAMPLE, "full example"), " as ", Code("health.luwu", "plaintext"), " and run it with ",
        Link("seal", "https://github.com/seal-runtime/seal/pull/295"):new_tab(), ":",
    }),
    CodeBlock("seal ./health.luwu", "bash"):copyable(),
    terminal(health.output),
    Paragraph({ PageLink(FULL_HEALTH_EXAMPLE, "See the full example on the Classes and Traits page →") }),

    h3("Destructuring"),
    Paragraph({
        "Destructuring pulls several fields into locals at once from anything you can index with a dot: tables, ",
        "objects, classes and userdata. It's similar to destructuring assignment in JavaScript and destructuring ",
        "patterns in Rust. Use it in ", Code("local"), " and ", Code("const"), " declarations:",
    }),
    luwu([====[
        const player = { name = "Ada", level = 12 }
        const .{ name, level } = player
        print(name, level)
    ]====]),
    Paragraph({ "And in a ", Code("for"), " loop's header:" }),
    luwu([====[
        const tasks = {
            { title = "Feed Nyla", done = true },
            { title = "Write docs", done = false },
        }
        for _, .{ title, done } in tasks do
            print(title, done)
        end
    ]====]),
    see_more(destructuring),

    h3("Restructuring"),
    Paragraph({
        "The same syntax on the right of ", Code("="), " builds a table instead: ", Code(".{ name, age }"),
        " is equivalent to ", Code("{ name = name, age = age }"), ". It's similar to shorthand properties in ",
        "JavaScript and field init shorthand in Rust. ", Code("Class.{ name, age }"),
        " builds a class without a primary constructor the same way.",
    }),
    luwu([====[
        const name, age = "Ada", 36
        const person = .{ name, age }
        print(person.name, person.age)
    ]====]),

    h3("The none Primitive"),
    Paragraph({ Code("none"), " means \"intentionally empty\". Unlike nil, you can store it in a table." }),
    luwu([====[
        const list = { "first", none, "third" }
        print(#list)
    ]====]),
    see_more(none_page),

    h2("Everyday code"),

    h3("Expressive Control Flow"),
    Paragraph({
        "Expressive control flow is a set of features that let you get a value, check it and decide what to do ",
        "with it in one expression. Combined, they make Luwu a more expression-focused language than Python or ",
        "Luau and make data transformation code much easier to read.",
    }),
    Paragraph({
        Code("if local"), " and ", Code("if const"), " bind a value inside the condition and ", Code("when"),
        " adds more checks that can use it:",
    }),
    luwu([====[
        const users: { [string]: { name: string, admin: boolean }? } = {
            ada = { name = "Ada", admin = true },
            grace = { name = "Grace", admin = false },
        }
        if const user = users["ada"] when user.admin then
            print(`{user.name} is an admin`)
        end
    ]====]),
    Paragraph({ "Loops take ", Code("when"), " chains too and skip the items that fail them:" }),
    luwu([====[
        const prices: { [string]: number? } = { apple = 1.25, pear = 0.8 }
        for
            _, fruit in { "apple", "kiwi", "pear" }
            when const price = prices[fruit]
        do
            print(`{fruit} costs {price}`)
        end
    ]====]),
    Paragraph({
        "A ", Code("do"), " expression runs statements anywhere an expression goes and ", Code("give"),
        "s back a value. In Luwu we prefer ", Code("do"), "/", Code("give"),
        " blocks over temporary and intermediate variables. They're useful in a lot of places:",
    }),
    UnorderedList({
        ListItem("Making obvious what the code is actually building up by scoping the computation inside the "
            .. "expression that produces the value."),
        ListItem("Putting several statements where only an expression fits, like a table field or an argument."),
        ListItem({ "Debugging a value in place: ", Code("do print(x) give x"), "." }),
        ListItem("Costing nothing: unlike a function call that abstracts the same computation, they're always "
            .. "inlined."),
    }),
    luwu([====[
        const scores = { 72, 95, 88 }
        const best = do
            local top = 0
            for _, score in scores do
                top = math.max(top, score)
            end
            give top
        print(best)
    ]====]),
    Paragraph({
        Code("or return"), ", ", Code("or continue"), " and ", Code("or break"),
        " leave as soon as a value is missing:",
    }),
    luwu([====[
        const function describe(fruit: string): string
            const price = prices[fruit] or return `{fruit} isn't sold here`
            return `{fruit} costs {price}`
        end
    ]====]),
    see_more(control_flow),

    h3("Table Comprehensions"),
    Paragraph("A table comprehension builds a new table from a loop, in one expression."),
    luwu([====[
        const numbers = { 1, 2, 3, 4, 5, 6 }

        const even_squares = { for _, n in numbers when n % 2 == 0 give n * n }
        print(#even_squares)
    ]====]),
    see_more(comprehensions),

    h3("Default Arguments"),
    Paragraph("Function parameters and class constructor parameters can have default values:"),
    luwu([====[
        const function greet(name: string, greeting = "Hello")
            print(`{greeting}, {name}!`)
        end

        greet("Ada")
    ]====]),
    see_more(default_arguments),

    h3("Named functions in table literals"),
    Paragraph("In Luau, a function stored in a table is a key assigned an anonymous function:"),
    luwu([====[
        local handlers = {
            on_start = function()
                print("started")
            end,
        }
        handlers.on_start()
    ]====]),
    Paragraph({
        "In Luwu, you can declare it like any other function, with ", Code("function name()"),
        " inside the table:",
    }),
    luwu([====[
        const handlers = {
            function on_start()
                print("started")
            end,
            function on_stop()
                print("stopped")
            end,
        }

        handlers.on_start()
        handlers.on_stop()
    ]====]),
    Paragraph({
        "It reads the same as a ", Code("const function"), " or a class method, and a function without a name is ",
        "still a list item, like in Luau.",
    }),

    h3("Importing classes with their types"),
    Paragraph("In Luau, a value and a type are imported separately. A class-like table needs both lines:"),
    CodeBlock([====[
        local shapes = require("./shapes")
        local Circle = shapes.Circle
        type Circle = shapes.Circle
    ]====], "luau"),
    Paragraph("A Luwu class is a value and a type at once. Given a module that exports one:"),
    CodeBlock([====[
        export class Circle(radius: number)
            function area(self): number
                return math.pi * self.radius ^ 2
            end
        end
    ]====]),
    Paragraph("Importing the class brings its type along, whichever way you import it:"),
    CodeBlock([====[
        const shapes = require("./shapes")
        const Circle = shapes.Circle
    ]====]),
    CodeBlock([====[
        const .{ Circle } = require("./shapes")

        const function describe(circle: Circle): string
            return `a circle with area {circle:area()}`
        end
    ]====]),
    Paragraph({
        "Traits work the same way. ", Code("type Circle = shapes.Circle"), " still works, but isn't needed.",
    }),

    h2("Libraries and embedding"),

    h3("Library Extensions"),
    Paragraph({
        "Luwu adds a few library functions. ", Code("table.drop"), " removes items from a list by value. ",
        "Unlike ", Code("table.remove(t, table.find(t, x))"), ", it doesn't remove the last item when x is missing.",
    }),
    luwu([====[
        const party = { "Ada", "Grace", "Alan" }

        table.drop(party, "Grace")
        print(#party)
    ]====]),
    Paragraph({
        "More are planned, like ", Code("table.keys"), ", ", Code("table.extend"), " and ", Code("string.startswith"),
        ".",
    }),
    see_more(library_extensions),

    h3("External Buffers and Strings"),
    Paragraph("Embedders can expose huge files to scripts without cloning them into the VM."),
    see_more(external_memory),

    h2("Experimental Features"),
    Paragraph("Push and pop operators, and match expressions. They work today, but their design may still change."),
    see_more(experimental),

}, "luwu/index.html")
    :add_page(
        compatibility,
        type_checking,
        literal_types,
        lints,
        hovers,
        classes,
        destructuring,
        none_page,
        control_flow,
        comprehensions,
        default_arguments,
        library_extensions,
        external_memory,
        experimental
    )
