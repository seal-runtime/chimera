--!strict
--!optimize 2
--!lint ConstLocal

const .{
    elements.{ Heading, Paragraph, Link, UnorderedList, ListItem },
    components.{ Code, CodeBlock, SiteFooter },
    site.{ Page, TableOfContents },
} = require("@chimera")
const .{ examples_in } = require("./example")
const .{ h1, h2, h3 } = Heading

const example = examples_in("examples/guide/sites.luwu")

--@ footer
const footer = SiteFooter()
    :link_column("Docs", { Link("Install", "#"), Link("Themes", "#") })
    :link_column("Community", { Link("Discord", "#"), Link("GitHub", "#") })
    :copyright("Ada Lovelace", "Built with chimera.")
--@ end

return Page("Sites and pages", {
    h1("Sites and pages"),
    Paragraph({
        "A documentation site with 30 pages repeats its header, footer and theme list 30 times, and sooner or ",
        "later one copy falls out of date. In chimera you set those parts once on a ", Code("Site"), " and give ",
        "each ", Code("Page"), " only its own content.",
    }),
    TableOfContents(),

    h2("Pages"),
    Paragraph({
        "A ", Code("Page"), " takes a title, its content and an optional file name. Without one, the file is ",
        "named after the title in lowercase with dashes: ", Code("Page(\"Getting started\")"), " writes ",
        Code("getting-started.html", "plaintext"), ".",
    }),
    CodeBlock([====[
        const home = Page("Home", { h1("Welcome"), Paragraph("Start here.") }, "index.html")
        const faq = Page("FAQ", h1("FAQ"))
        faq:add(h2("Is it free?"), Paragraph("Yes."))
    ]====]),
    Paragraph({ Code("add"), " appends more content later." }),

    h2("Nested pages"),
    Paragraph({
        "Pages can hold pages of their own, and those go in a folder named after their parent. ",
        "A parent called ", Code("index.html", "plaintext"), " shares its folder with its children instead:",
    }),
    CodeBlock([====[
        const docs = Page("Docs", h1("Docs"), "docs/index.html")
            :add_page(
                Page("Install"), -- docs/install.html
                Page("Themes")   -- docs/themes.html
            )
        const guide = Page("Guide")  -- guide.html
            :add_page(Page("Setup")) -- guide/setup.html
    ]====]),
    Paragraph({
        "This page is ", Code("guide/sites-and-pages.html", "plaintext"), ", a child of the Guide. ",
        "Nested pages get breadcrumbs above their content like the ones at the top of this page, and ",
        Code("site:breadcrumbs(false)"), " turns them off.",
    }),

    h2("Links between pages"),
    Paragraph({
        Code("PageLink"), " points at a ", Code("Page"), " object rather than a path. When the page renders, ",
        "the link works out the relative path from its own folder. Moving a page never breaks the links to it. ",
        "The text defaults to the page's title:",
    }),
    CodeBlock([====[
        PageLink(faq)                  -- "FAQ"
        PageLink(docs, "Read the docs")
        PageLink("docs/install.html")  -- a path from the site's root
    ]====]),
    Paragraph({
        "Because every link is relative, the built site also works from disk over ",
        Code("file://", "plaintext"), ". You don't need a server to check it.",
    }),

    h2("Tables of contents"),
    Paragraph({
        Code("TableOfContents()"), " lists its page's headings and the pages under it. It's built when the ",
        "page renders, from whatever the page holds at that moment. ",
        "The box at the top of this page is one; on wide screens it moves into a column beside the text.",
    }),
    CodeBlock([====[
        TableOfContents()                    -- this page's h2 and h3 headings, and its subpages
        TableOfContents("page", 2)           -- h2 headings only
        TableOfContents("site", 3, "Pages")  -- every page of the site, for a sidebar
    ]====]),

    h2("The site"),
    Paragraph({
        "A ", Code("Site"), " holds the top-level pages and everything they share. ", Code("build"),
        " writes them all, creating folders as it goes, and returns the paths it wrote:",
    }),
    CodeBlock([====[
        const site = Site("My docs")
            :describe("Guides and reference for my library")
            :default_dark_theme(catppuccin.Mocha)
            :default_light_theme(catppuccin.Latte)
            :add_page(home, docs, faq)

        for _, path in site:build("out") do
            print(`wrote {path}`)
        end
    ]====]):copyable(),
    Paragraph({
        "Two pages with the same path are an error rather than a silent overwrite. ", Code("describe"),
        " sets the summary search engines show, and a page can override it with its own ", Code("describe"), ".",
    }),

    h2("Header, footer and sidebar"),
    Paragraph({
        "Unless you say otherwise, every page gets a header with a menu of the top-level pages and a theme ",
        "switcher, plus a footer with the site's copyright. Pass your own to replace either one, or ", Code("none"),
        " to leave it out:",
    }),
    CodeBlock([====[
        site
            :header(Header { Menu { PageLink(home, "My docs"), PageLink(docs), ThemeSwitcher() } })
            :footer(none)
            :sidebar(TableOfContents("site", 2, "Pages"))
    ]====]),
    Paragraph({
        Code("SiteFooter"), " builds a footer like this site's with link columns, a copyright line and ",
        "legal links:",
    }),
    example("footer", footer),

    h2("Search"),
    Paragraph({
        "Readers of an API reference usually know a name, or half of one. They remember ", Code("readFileSync"),
        " but type ", Code("read file", "plaintext"), ", or they misspell it ", Code("raedfilesync", "plaintext"),
        " on the way. ", Code("site:search()"), " puts a box in the header that finds pages, sections and ",
        "anything your own elements add while the reader types. It needs no server and works over ",
        Code("file://", "plaintext"), " too:",
    }),
    CodeBlock([====[
        site:search()
    ]====]),
    Paragraph({
        Code("build"), " writes the index the box searches, ", Code("search-index.js", "plaintext"),
        ", next to the pages. A site with its own header adds a ", Code("Search()"), " to it instead, and the ",
        "index gets written all the same. Results show up under the box grouped by page, with the matching words ",
        "marked. Arrow keys move through them and Enter opens one, and ", Code("/", "plaintext"), " or ",
        Code("Ctrl+K", "plaintext"), " jumps to the box from anywhere on the page.",
    }),

    h3("How it matches"),
    Paragraph({
        "Every word of a query has to match somewhere in an entry: its title, its keywords, the title of its page ",
        "or its text. Each word is tried several ways, and the best one counts:",
    }),
    UnorderedList({
        ListItem({ Code("Exact"), ": the whole name, or the part after its last dot, so ", Code("readfile"),
            " finds ", Code("fs.readfile"), "." }),
        ListItem({ Code("Prefix"), ": the start of a name, like ", Code("fs.read"), "." }),
        ListItem({ Code("Words"), ": names split the way programmers write them. ", Code("readFileSync"), ", ",
            Code("read_file_sync"), " and ", Code("ReadFileSync"), " all have the words read, file and sync, so ",
            Code("read sync", "plaintext"), " and ", Code("http server", "plaintext"), " find them." }),
        ListItem({ Code("Initials"), ": the first letter of each word, so ", Code("rfs", "plaintext"),
            " finds ", Code("readFileSync"), " and ", Code("gcd", "plaintext"), " finds ", Code("get_current_dir"),
            "." }),
        ListItem({ Code("Substring"), ": anywhere inside a name, so ", Code("lines", "plaintext"), " finds ",
            Code("splitlines"), "." }),
        ListItem({ Code("Typos"), ": a name within one or two typos, so ", Code("splitlnies", "plaintext"),
            " finds ", Code("splitlines"), ". Words under four letters allow none, which keeps ",
            Code("os", "plaintext"), " from finding ", Code("fs"), "." }),
        ListItem({ Code("FullText"), ": words in an entry's text, so ", Code("utf8", "plaintext"),
            " finds the section that explains encodings even when its title doesn't say so." }),
    }),
    Paragraph({
        "A query with capital letters ranks names written in the same case higher. Pass ", Code("Search"),
        " your own list of matchers to drop some or change how much each one counts. A matcher left out never ",
        "matches, and ", Code("weigh"), " sets how much each part of an entry counts:",
    }),
    CodeBlock([====[
        site:search(Search()
            :matchers({ Exact(200), Prefix(), Words(), Typos(25, 1) })
            :weigh({ page = 0 })
        )
    ]====]),

    h3("What it shows"),
    Paragraph({
        "An API reference's search might show functions only, five at a time, without the text around each match. ",
        "These settings cover that:",
    }),
    CodeBlock([====[
        Search()
            :placeholder("Search the API")
            :kinds({ "function", "type" })
            :limit(5)
            :min_score(20)
            :snippets(false)
            :group_by_page(false)
            :shortcut("s")
    ]====]),
    Paragraph({
        "Pages are the kind ", Code("\"page\""), " and their sections are ", Code("\"section\""),
        ". Other kinds come from your own elements.",
    }),

    h3("Your own entries"),
    Paragraph({
        "An element that stands for something readers search for, like a function in a reference, says so in ",
        Code("search_entries"), ". The index adds its entries and skips its children. Give the element its id ",
        "before the page renders so the result has somewhere to land:",
    }),
    CodeBlock([====[
        class ApiFunction implements Component
            function tag(): string
                return "div"
            end
            name = ""
            summary = ""
            function __init(self, name: string?, summary: string?)
                self.name = name or ""
                self.summary = summary or ""
                self:id((string.gsub(self.name, "%W+", "-")))
            end
            function search_entries(self): { SearchEntry }?
                return {
                    {
                        kind = "function",
                        title = self.name,
                        anchor = self:get_id(),
                        text = self.summary,
                        keywords = { "read" },
                    },
                }
            end
        end
    ]====]),

    h3("Your own matchers"),
    Paragraph({
        "Matching runs in the reader's browser, so a matcher of your own is a class with a little JavaScript. ",
        Code("source"), " returns a function that scores a query word against a name from 0 to 1. Register the ",
        "class so parsed pages find it again:",
    }),
    CodeBlock([====[
        class Suffix(weight: number = 30) implements Matcher
            function source(self): string?
                return [=[
                    function (term, field) {
                        return field.lower.endsWith(term.lower) ? 1 : 0;
                    }
                ]=]
            end
        end
        Matcher.register(Suffix)

        site:search(Search():matchers({ Exact(), Prefix(), Suffix() }))
    ]====]),

    h2("Per-page changes"),
    Paragraph({
        "For anything the site doesn't set itself, ", Code("customize"), " runs a function on each page's ",
        Code("Document"), " just before it's written:",
    }),
    CodeBlock([====[
        site:customize(function(document, page)
            document:link_stylesheet("https://fonts.googleapis.com/css2?family=Inter")
            if page.title == "Home" then
                document:describe("My library: fast, typed and small")
            end
        end)
    ]====]),
    Paragraph({
        "chimera only writes pages. Copy images and other files into the output folder yourself with ",
        Code("fs.copy"), ".",
    }),
})
