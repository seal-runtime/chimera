--!strict
--!optimize 2
--!lint ConstLocal

const .{
    elements.{ Heading, Paragraph, Link, Footer, Small },
    components.{ Code, CodeBlock },
    style.{ token, Color },
    site.{ Page, PageLink, TableOfContents },
} = require("@chimera")
const .{ examples_in } = require("./example")
const .{ h1, h2 } = Heading

const example = examples_in("examples/guide/styling.luwu")

--@ inline
const note = Paragraph("Back up your saves before updating.")
    :style({
        padding = "0.75rem 1rem",
        background = token("surface"),
        border_left = `4px solid {token("accent")}`,
        border_radius = token("radius"),
    })
--@ end

--@ inside
const credits = Footer({ Small("Art by Nyla."), Link("More art", "#") })
    :row()
    :style_inside(Link, { color = token("muted") })
--@ end

--@ colors
const swatch = Paragraph("Tinted")
    :style({
        padding = "0.5rem 1rem",
        color = Color.named("white"),
        background = Color.hex("#3b5bdb"):mix(Color.named("black"), 0.25),
        border_radius = token("radius"):times(2),
    })
--@ end

return Page("Styling", {
    h1("Styling"),
    Paragraph({
        "CSS has hundreds of properties, and a browser silently ignores a typo in any of them. In chimera a ",
        "style is a Luwu table whose values Luwu's type function validators check during analysis: ",
        Code("padding = \"1rx\""), " is a type error, and ", Code("dispaly = \"flex\""), " gets a \"did you mean\". ",
        "Styles can also read theme tokens, and then they follow the reader's theme with no extra CSS.",
    }),
    TableOfContents(),

    h2("One element"),
    Paragraph({ Code("style"), " sets an element's inline style:" }),
    example("inline", note),
    Paragraph({
        "Keys are CSS property names with underscores instead of dashes. Keyword properties like ",
        Code("display"), " only accept their real values, while lengths also take plain numbers like ",
        Code("margin = 0"), ". Vendor prefixes start with ", Code("webkit_"), " or ", Code("moz_"),
        ", and custom properties go in brackets: ", Code("[\"--gap\"] = \"1rem\""), ".",
    }),

    h2("Theme tokens"),
    Paragraph({
        Code("token(\"accent\")"), " stands for ", Code("var(--chimera-accent)", "css"), ", the current theme's ",
        "accent color. When the reader switches themes, every style that uses it changes with them. ",
        "These are the tokens every theme sets:",
    }),
    CodeBlock([====[background  surface  text  muted  border
primary  primary_text  accent
radius  spacing  font  mono_font  shadow
syntax_keyword  syntax_string  syntax_comment  ...  syntax_error]====], "plaintext"),
    Paragraph({
        Code("token(\"radius\"):times(1.5)"), " scales a length token, and ",
        Code("token(\"primary\"):mix(token(\"background\"), 20)"), " blends 20% of one color token into another.",
    }),

    h2("Colors"),
    example("colors", swatch),
    Paragraph({
        Code("Color.hex"), " checks its literal while you type, and ", Code("Color.named"),
        " takes any CSS color name. Colors also convert to and from vectors, packed numbers, buffers and ANSI codes.",
    }),

    h2("Inside one element"),
    Paragraph({
        Code("style_inside"), " styles the matching elements inside one element and leaves the rest of the page alone:",
    }),
    example("inside", credits),

    h2("Every element of a kind"),
    Paragraph({
        Code("style_every"), " on a ", Code("Document"), " or a ", Code("Site"), " styles everything that ",
        "matches an element class or a CSS selector. These rules come after the theme's and win over them:",
    }),
    CodeBlock([====[site
    :style_every(Button, { border_radius = "999px" })
    :style_every(Card, { padding = "2rem" })
    :style_every(".hero h1", { font_size = "3rem" })]====]),

    h2("Rules and stylesheets"),
    Paragraph({
        "A ", Code("Rule"), " pairs a selector with a style. For media queries, nest rules inside one:",
    }),
    CodeBlock([====[document:css({
    Rule("nav a", { color = token("text") }),
    Rule("@media (max-width: 600px)", {}, {
        Rule("nav", { flex_direction = "column" }),
    }),
})]====]),
    Paragraph({
        Code("document:css(text)"), " also takes plain CSS, and ", Code("link_stylesheet(href)"),
        " links a stylesheet file. Going the other way, ", Code("Rule.parse"), " and ", Code("Style.parse"),
        " read CSS back into objects.",
    }),
    Paragraph({
        "Styles that a component always needs belong in the component itself, as ",
        PageLink("guide/custom-components.html", "Custom components"), " shows.",
    }),
})
