--!strict
--!optimize 2
--!lint ConstLocal

const .{ core.{ Markup } } = require("@chimera")

--- A value for a failure message. A node shows its tree, since `tostring` gives its embed marker.
const function shown(value: unknown): string
    if class.implements(value, Markup) then
        return value:debug()
    end
    return tostring(value)
end

const function equal<T>(actual: T, expected: T, label: string?)
    if actual ~= expected then
        error(`{label or "values differ"}\n    expected: {shown(expected)}\n    actual:   {shown(actual)}`, 2)
    end
end

const function truthy(value: unknown, label: string?)
    if not value then
        error(label or "expected a truthy value", 2)
    end
end

const function contains(haystack: string, needle: string, label: string?)
    if not haystack:contains(needle) then
        error(`{label or "missing text"}\n    expected to find: {needle}\n    in: {haystack}`, 2)
    end
end

const function excludes(haystack: string, needle: string, label: string?)
    if haystack:contains(needle) then
        error(`{label or "unexpected text"}\n    expected not to find: {needle}\n    in: {haystack}`, 2)
    end
end

--- Assertions shared by the test modules; each raises at the caller's line.
const assertions = .{
    equal,
    truthy,
    contains,
    excludes,
}

return assertions
