--!strict
--!optimize 2
--!lint ConstLocal

const .{ equal, contains, excludes } = require("./assert")
const chimera = require("@chimera")
const .{
    core.{ Element, Text, Raw, Comment, Fragment, Tag },
    elements.{ Div, Image, Main, Heading, Paragraph, Link, Strong },
} = chimera

const function plain(text: string): string
    return (string.gsub(text, "\27%[[%d;]*m", ""))
end

const tests: { [string]: () -> () } = {
    ["text and attributes are escaped"] = function()
        const html = Div("a < b & c")
            :attr("title", `say "hi"`)
            :to_html()
        equal(html, `<div title="say &quot;hi&quot;">a &lt; b &amp; c</div>`)
    end,

    ["raw html is written verbatim"] = function()
        equal(Div(Raw("<b>x</b>")):to_html(), "<div><b>x</b></div>")
    end,

    ["comments render and can't close early"] = function()
        equal(Comment("a -- b"):to_html(), "<!--a - - b-->")
    end,

    ["content flattens lists, numbers and nil"] = function()
        const html = Div({ "a", 1, Strong("b") })
            :add(nil, { Paragraph("c") })
            :to_html()
        equal(html, "<div>a1<strong>b</strong><p>c</p></div>")
    end,

    ["boolean attributes render bare and false removes"] = function()
        const div = Div()
            :attr("hidden", true)
            :attr("draggable", "true")
        equal(div:to_html(), `<div hidden draggable="true"></div>`)
        div:attr("hidden", false)
        equal(div:to_html(), `<div draggable="true"></div>`)
    end,

    ["classes dedupe and render after attributes"] = function()
        const div = Div()
            :add_style_class("a b", "a")
            :id("x")
            :add_style_class("c")
            :remove_style_class("b")
        equal(div:to_html(), `<div id="x" class="a c"></div>`)
        equal(div:has_style_class("a"), true)
        equal(div:get_attr("class"), "a c")
    end,

    ["class and style attributes map to their fields"] = function()
        const div = Div()
            :attr("class", "one two")
            :attr("style", "color: red")
        equal(div.style_classes[2], "two")
        equal(div:get_attr("style"), "color: red")
        div:style({ margin = 0 })
        equal(div:to_html(), `<div class="one two" style="color: red; margin: 0"></div>`)
    end,

    ["events and data attributes"] = function()
        const html = Div()
            :on("click", "go()")
            :data("id", 4)
            :to_html()
        equal(html, `<div onclick="go()" data-id="4"></div>`)
    end,

    ["void tags have no closing tag"] = function()
        equal(Image("a.png", "A"):to_html(), `<img src="a.png" alt="A">`)
    end,

    ["generic tags lower-case their name"] = function()
        equal(
            Tag("DIALOG", "hi")
                :attr("open", true)
                :to_html(),
            "<dialog open>hi</dialog>"
        )
    end,

    ["fragments render children without a wrapper"] = function()
        equal(Div(Fragment { "a", Strong("b") }):to_html(), "<div>a<strong>b</strong></div>")
    end,

    ["tap runs imperative steps inside a chain"] = function()
        const div = Div():tap(function(el)
            for index = 1, 3 do
                el:add(Paragraph(index))
            end
        end)
        equal(#div.children, 3)
    end,

    ["style_inside generates an id once"] = function()
        const nav = Div()
            :style_inside(Link, { color = "red" })
            :style_inside("p", { margin = 0 })
        const id = nav:get_id()
        equal(id ~= nil, true)
        const rules = nav.inside_rules or {}
        equal(rules[1].selector, `#{id} a`)
        equal(rules[2].selector, `#{id} p`)
    end,

    ["pretty printing indents block children only"] = function()
        const html = Main { Heading.h1("Title"), Paragraph { "a ", Strong("b") } }:to_html(true)
        equal(html, "<main>\n  <h1>Title</h1>\n  <p>a <strong>b</strong></p>\n</main>")
    end,

    ["display prints a tree"] = function()
        const shown = plain(Div { Paragraph("hi"), Image("x.png") }
            :id("box")
            :display()
        )
        equal(shown, "Div#box\n├─ Paragraph<p>\n│  └─ \"hi\"\n└─ Image<img> src")
    end,

    ["tostring is the outline"] = function()
        equal(plain(`{Div():add_style_class("card")}`), "Div.card")
    end,

    ["create falls back to Tag for unknown tags"] = function()
        const element = Element.create("x-widget")
        equal(element:to_html(), "<x-widget></x-widget>")
        contains(Element.create("p"):outline(), "Paragraph")
    end,

    ["text nodes are inline"] = function()
        equal(Text("x"):is_inline(), true)
        excludes(Div(Text("x")):to_html(true), "\n")
    end,
}

return tests
